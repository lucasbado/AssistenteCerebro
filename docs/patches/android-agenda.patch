+++ b/app/src/main/java/com/example/assistentecell/agenda/AgendaActivity.kt
@@ -0,0 +1,171 @@
+package com.example.assistentecell.agenda
+
+import android.content.Intent
+import android.os.Bundle
+import android.provider.AlarmClock
+import android.provider.CalendarContract
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.example.assistentecell.api.RetrofitClient
+import com.example.assistentecell.ui.theme.AssistenteCellTheme
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Locale
+import java.util.TimeZone
+
+class AgendaActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        RetrofitClient.init(this)
+        setContent { AssistenteCellTheme(darkTheme = true, dynamicColor = false) { AgendaPage() } }
+    }
+
+    private fun calendar(item: AgendaItem) {
+        var begin = AgendaDates.instant(item.inicio)
+        if (item.dia_inteiro) {
+            val local = Calendar.getInstance().apply { timeInMillis = begin }
+            begin = Calendar.getInstance(TimeZone.getTimeZone("UTC")).apply {
+                clear(); set(local.get(Calendar.YEAR), local.get(Calendar.MONTH), local.get(Calendar.DAY_OF_MONTH))
+            }.timeInMillis
+        }
+        startActivity(Intent(Intent.ACTION_INSERT).setData(CalendarContract.Events.CONTENT_URI)
+            .putExtra(CalendarContract.Events.TITLE, item.titulo)
+            .putExtra(CalendarContract.EXTRA_EVENT_BEGIN_TIME, begin)
+            .putExtra(CalendarContract.EXTRA_EVENT_END_TIME, begin + if (item.dia_inteiro) 86400000L else 3600000L)
+            .putExtra(CalendarContract.EXTRA_EVENT_ALL_DAY, item.dia_inteiro))
+    }
+
+    private fun clock(item: AgendaItem) {
+        val start = AgendaDates.instant(item.inicio)
+        require(AgendaDates.isNextClockOccurrence(start)) {
+            "O Relógio recebe o próximo horário, não uma data distante. Para esse dia, use a agenda e revise o despertador mais perto da data."
+        }
+        val time = Calendar.getInstance().apply { timeInMillis = start }
+        startActivity(Intent(AlarmClock.ACTION_SET_ALARM)
+            .putExtra(AlarmClock.EXTRA_HOUR, time.get(Calendar.HOUR_OF_DAY))
+            .putExtra(AlarmClock.EXTRA_MINUTES, time.get(Calendar.MINUTE))
+            .putExtra(AlarmClock.EXTRA_MESSAGE, item.titulo)
+            .putExtra(AlarmClock.EXTRA_SKIP_UI, false))
+    }
+
+    @Composable
+    private fun AgendaPage() {
+        val scope = rememberCoroutineScope()
+        val api = remember { RetrofitClient.cognitiveApiService }
+        var items by remember { mutableStateOf<List<AgendaItem>>(emptyList()) }
+        var selected by remember { mutableStateOf(intent.getStringExtra("agenda_id")) }
+        var busy by remember { mutableStateOf(false) }
+        var error by remember { mutableStateOf<String?>(null) }
+        var notice by remember { mutableStateOf<String?>(null) }
+        var newForm by remember { mutableStateOf(false) }
+        var title by remember { mutableStateOf("") }
+        var date by remember { mutableStateOf("") }
+        var time by remember { mutableStateOf("") }
+        var kind by remember { mutableStateOf("compromisso") }
+        var lead by remember { mutableStateOf("0") }
+
+        fun run(action: suspend () -> Unit) {
+            if (busy) return
+            busy = true; error = null; notice = null
+            scope.launch {
+                try { action() }
+                catch (e: CancellationException) { throw e }
+                catch (e: Exception) {
+                    error = if (e is retrofit2.HttpException) when(e.code()) {
+                        401 -> "Confira a conexão e o token nas configurações."
+                        404 -> "Esse item não está disponível. O servidor pode precisar da atualização."
+                        422 -> "Confira a data e o horário. O servidor não aceitou esse pedido."
+                        else -> "A agenda não respondeu. Tente novamente."
+                    } else e.message ?: "Não consegui concluir. Tente novamente."
+                } finally { busy = false }
+            }
+        }
+        suspend fun reload() {
+            val all = api.getAgenda()
+            val id = selected
+            items = if (id != null && all.none { it.id == id }) listOf(api.getAgendaItem(id)) + all else all
+        }
+        LaunchedEffect(Unit) { run { reload() } }
+
+        Surface(Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+            Column(Modifier.fillMaxSize().systemBarsPadding().verticalScroll(rememberScrollState()).padding(20.dp),
+                verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                    TextButton(onClick = { finish() }) { Text("Voltar") }
+                    TextButton(enabled = !busy, onClick = { run { reload() } }) { Text("Atualizar") }
+                }
+                Text("Sua agenda", style = MaterialTheme.typography.headlineMedium)
+                Text("Datas importantes, sem deixar os detalhes se perderem.", color = MaterialTheme.colorScheme.onSurfaceVariant)
+                if (busy) LinearProgressIndicator(Modifier.fillMaxWidth())
+                error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+                notice?.let { Text(it, color = MaterialTheme.colorScheme.secondary) }
+                OutlinedButton(onClick = { newForm = !newForm; selected = null }) { Text(if (newForm) "Fechar formulário" else "Novo compromisso ou despertador") }
+                if (newForm) {
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                        listOf("compromisso", "lembrete", "alarme").forEach { option ->
+                            FilterChip(selected = kind == option, onClick = { kind = option }, label = { Text(option.replaceFirstChar { it.uppercase() }) })
+                        }
+                    }
+                    OutlinedTextField(value = title, onValueChange = { title = it }, label = { Text("O que é?") }, modifier = Modifier.fillMaxWidth())
+                    OutlinedTextField(value = date, onValueChange = { date = it }, label = { Text("Data — dd/mm/aaaa") }, modifier = Modifier.fillMaxWidth())
+                    OutlinedTextField(value = time, onValueChange = { time = it }, label = { Text("Horário — HH:mm") }, supportingText = { Text("Em compromisso, deixe vazio para dia inteiro.") }, modifier = Modifier.fillMaxWidth())
+                    if (kind != "alarme") OutlinedTextField(value = lead, onValueChange = { lead = it }, label = { Text("Avisar quantos minutos antes? (0 = na hora)") }, modifier = Modifier.fillMaxWidth())
+                    Button(enabled = !busy, onClick = { run {
+                        require(title.isNotBlank()) { "Escreva o título." }
+                        require(time.isNotBlank() || kind == "compromisso") { "Escolha o horário." }
+                        val formatter = SimpleDateFormat("dd/MM/yyyy HH:mm", Locale.ROOT).apply { isLenient = false }
+                        val input = date.trim() + " " + time.trim().ifEmpty { "00:00" }
+                        require(Regex("\\d{2}/\\d{2}/\\d{4} \\d{2}:\\d{2}").matches(input)) { "Use dd/mm/aaaa e HH:mm." }
+                        val parsed = formatter.parse(input) ?: error("Confira a data.")
+                        val minutes = if(kind == "alarme") 0 else lead.toIntOrNull() ?: error("Use um número de minutos.")
+                        require(minutes in 0..10080) { "Use entre 0 e 10080 minutos." }
+                        val iso = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ssXXX", Locale.ROOT).format(parsed)
+                        val saved = api.createAgendaItem(NewAgendaItem(kind, title.trim(), iso, time.isBlank(), minutes))
+                        selected = saved.id; newForm = false; reload()
+                        notice = if(kind == "alarme") "Pedido preparado. Revise no Relógio abaixo." else "Guardado na sua agenda."
+                    } }) { Text("Guardar na Ollie") }
+                }
+                if (selected != null) TextButton(onClick = { selected = null }) { Text("Ver todos") }
+                val visible = items.filter { selected == null || it.id == selected }
+                if (!busy && visible.isEmpty()) Text("Nada guardado por aqui ainda. Você também pode pedir pela conversa.")
+                visible.forEach { item ->
+                    Card(Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                            Text(item.titulo, style = MaterialTheme.typography.titleLarge)
+                            Text(item.quando, color = MaterialTheme.colorScheme.secondary)
+                            Text(when(item.estado) {
+                                "sugestao" -> "Sugestão • revise antes de salvar"
+                                "preparado" -> "Despertador preparado • ativação no Relógio não confirmada"
+                                "agendado" -> "Guardado na Ollie"
+                                "cancelado" -> "Retirado da Ollie"
+                                else -> "Concluído"
+                            })
+                            if (item.estado !in listOf("cancelado", "concluido")) {
+                                if (item.estado == "sugestao") Button(enabled = !busy, onClick = { run {
+                                    api.setAgendaState(item.id, AgendaState("agendado")); reload(); notice = "Guardado na agenda."
+                                } }) { Text("Salvar na agenda") }
+                                if (item.tipo == "alarme") {
+                                    Button(enabled = !busy, onClick = { run { clock(item); notice = "Confira e salve o despertador no Relógio." } }) { Text("Revisar no Relógio") }
+                                    Text("Retirar da Ollie não desativa um alarme já salvo no Relógio.", style = MaterialTheme.typography.bodySmall)
+                                } else {
+                                    OutlinedButton(enabled = !busy, onClick = { run { calendar(item); notice = "Confira e salve no aplicativo de calendário." } }) { Text("Salvar no calendário do celular") }
+                                    Text(if(item.dia_inteiro) "Dia inteiro • sem aviso em horário específico." else "Aviso da Ollie: ${item.antecedencia_minutos} min antes. Depende do servidor e da conexão.", style = MaterialTheme.typography.bodySmall)
+                                }
+                                TextButton(enabled = !busy, onClick = { run { api.setAgendaState(item.id, AgendaState("cancelado")); reload(); notice = "Retirado da agenda da Ollie." } }) { Text(if(item.estado == "sugestao") "Descartar sugestão" else "Retirar da Ollie") }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
