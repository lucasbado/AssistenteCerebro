+package com.example.assistentecell
+
+import com.example.assistentecell.agenda.AgendaDates
+import org.junit.Assert.*
+import org.junit.Test
+import java.util.TimeZone
+
+class AgendaDatesTest {
+    private val zone = TimeZone.getTimeZone("America/Sao_Paulo")
+    @Test fun parseUtcOffsetAndFraction() {
+        assertEquals(AgendaDates.instant("2030-10-23T07:00:00-03:00"), AgendaDates.instant("2030-10-23T10:00:00.123456+00:00"))
+    }
+    @Test fun clockOnlyAcceptsNextOccurrence() {
+        val now = AgendaDates.instant("2030-10-22T20:00:00-03:00")
+        assertTrue(AgendaDates.isNextClockOccurrence(AgendaDates.instant("2030-10-23T07:00:00-03:00"), now, zone))
+        assertFalse(AgendaDates.isNextClockOccurrence(AgendaDates.instant("2030-10-24T07:00:00-03:00"), now, zone))
+        assertFalse(AgendaDates.isNextClockOccurrence(AgendaDates.instant("2030-10-22T07:00:00-03:00"), now, zone))
+    }
+    @Test fun clockAcceptsTodayFutureButNotTomorrowSameTime() {
