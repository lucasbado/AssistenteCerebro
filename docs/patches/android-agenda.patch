+package com.example.assistentecell.agenda
+
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Locale
+import java.util.TimeZone
+
+data class AgendaAction(val id: String, val texto: String, val quando: String, val tipo: String)
+data class AgendaItem(
+    val id: String, val tipo: String, val titulo: String, val inicio: String,
+    val dia_inteiro: Boolean, val antecedencia_minutos: Int, val estado: String,
+    val origem: String, val quando: String
+)
+data class AgendaState(val estado: String, val antecedencia_minutos: Int? = null)
+data class NewAgendaItem(val tipo: String, val titulo: String, val inicio: String,
+    val dia_inteiro: Boolean = false, val antecedencia_minutos: Int = 0)
+
+object AgendaDates {
+    fun instant(value: String): Long {
+        val cleaned = value.replace(Regex("\\.\\d+(?=Z|[+-]\\d{2}:\\d{2}$)"), "")
+        return SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ssXXX", Locale.ROOT).apply { isLenient = false }
+            .parse(cleaned)?.time ?: error("Data inválida recebida da agenda")
+    }
+
+    // ACTION_SET_ALARM não representa uma data absoluta. Nunca transformar semana que vem em amanhã.
+    fun isNextClockOccurrence(start: Long, now: Long = System.currentTimeMillis(), zone: TimeZone = TimeZone.getDefault()): Boolean {
+        if (start <= now) return false
+        val target = Calendar.getInstance(zone).apply { timeInMillis = start }
+        val next = Calendar.getInstance(zone).apply {
+            timeInMillis = now
+            set(Calendar.HOUR_OF_DAY, target.get(Calendar.HOUR_OF_DAY))
+            set(Calendar.MINUTE, target.get(Calendar.MINUTE))
+            set(Calendar.SECOND, 0); set(Calendar.MILLISECOND, 0)
+            if (timeInMillis <= now) add(Calendar.DAY_OF_MONTH, 1)
+        }
+        return start / 60000 == next.timeInMillis / 60000
+    }
+}
