+package com.example.assistentecell
+import com.example.assistentecell.messages.MessageOpeningPolicy
+import org.junit.Assert.*
+import org.junit.Test
+class MessageOpeningPolicyTest {
+    private val reference = "77c02a43-3b74-4a33-ad15-274754721276"
+    @Test fun conversationMustMatchContactAndApp() {
+        assertTrue(MessageOpeningPolicy.allowed(reference, "com.whatsapp", "Ana", "com.whatsapp", "Ana", 1000))
+        assertFalse(MessageOpeningPolicy.allowed(reference, "com.whatsapp", "Ana", "com.whatsapp", "Bia", 1000))
+        assertFalse(MessageOpeningPolicy.allowed(reference, "com.whatsapp", "Ana", "org.telegram.messenger", "Ana", 1000))
+    }
+    @Test fun expiredOrInvalidReferencesNeverOpenAnotherApp() {
+        assertFalse(MessageOpeningPolicy.allowed(reference, "com.whatsapp", "Ana", "com.whatsapp", "Ana", 3600001))
+        assertFalse(MessageOpeningPolicy.allowed("123", "com.whatsapp", "Ana", "com.whatsapp", "Ana", 1000))
+    }
+}
