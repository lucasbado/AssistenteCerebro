diff --git a/app/src/main/java/com/example/assistentecell/messages/MessageModels.kt b/app/src/main/java/com/example/assistentecell/messages/MessageModels.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/example/assistentecell/messages/MessageModels.kt
@@ -0,0 +1,15 @@
+package com.example.assistentecell.messages
+
+data class MessageAction(val id: String, val texto: String)
+data class MessageReview(val id: String, val pacote: String, val remetente: String, val texto: String,
+    val sinais: List<String>, val estado: String, val rascunho: String, val versao: Int,
+    val agenda_id: String?, val tarefa_id: String?, val quando: String, val referencia_notificacao: String)
+data class MessageChange(val acao: String, val versao: Int, val texto: String = "")
+data class ReviewUsage(val dispositivo: String = "MOBILE")
+
+object MessageOpeningPolicy {
+    fun allowed(reference: String, expectedPackage: String, expectedTitle: String,
+        cachedPackage: String, cachedTitle: String, ageMillis: Long): Boolean =
+        reference.matches(Regex("[0-9a-fA-F-]{36}")) && expectedPackage == cachedPackage &&
+        expectedTitle == cachedTitle && ageMillis in 0..3600000
+}
