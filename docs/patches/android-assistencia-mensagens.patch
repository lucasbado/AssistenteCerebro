@@ -0,0 +1,122 @@
+package com.example.assistentecell.messages
+
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.os.Bundle
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.horizontalScroll
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.example.assistentecell.ListenerDeNotificacoes
+import com.example.assistentecell.api.RetrofitClient
+import com.example.assistentecell.ui.theme.AssistenteCellTheme
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+
+class MessagesActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        RetrofitClient.init(this)
+        setContent { AssistenteCellTheme(darkTheme = true, dynamicColor = false) { Inbox() } }
+    }
+    private fun copy(text: String) {
+        getSystemService(ClipboardManager::class.java).setPrimaryClip(ClipData.newPlainText("Rascunho da Ollie", text))
+    }
+    @Composable private fun Inbox() {
+        val api = remember { RetrofitClient.cognitiveApiService }
+        val scope = rememberCoroutineScope()
+        var items by remember { mutableStateOf<List<MessageReview>>(emptyList()) }
+        var selected by remember { mutableStateOf(intent.getStringExtra("mensagem_id")) }
+        var filter by remember { mutableStateOf("revisar") }
+        var busy by remember { mutableStateOf(false) }
+        var error by remember { mutableStateOf<String?>(null) }
+        var feedback by remember { mutableStateOf<String?>(null) }
+        var registered by remember { mutableStateOf(false) }
+        fun run(action: suspend () -> Unit) {
+            if(busy) return
+            busy = true; error = null; feedback = null
+            scope.launch {
+                try { action() }
+                catch(e: CancellationException) { throw e }
+                catch(e: Exception) {
+                    error = if(e is retrofit2.HttpException) when(e.code()) {
+                        404 -> "Mensagens indisponíveis. Confira se o servidor recebeu a atualização."
+                        409 -> "Essa revisão mudou. Atualize a caixa antes de tentar novamente."
+                        422 -> try { org.json.JSONObject(e.response()?.errorBody()?.string().orEmpty()).optString("detail").take(400) }
+                            catch(_: Exception) { "Confira a ação e os dados da mensagem." }
+                        else -> "Não consegui concluir agora. Seu rascunho não foi enviado."
+                    } else e.message ?: "Não consegui concluir agora."
+                } finally { busy = false }
+            }
+        }
+        suspend fun load() {
+            val all = if(!registered && filter == "revisar") api.reviewMessages(ReviewUsage()).also { registered = true } else api.getMessages(filter)
+            val id = selected
+            items = if(id != null && all.none { it.id == id }) listOf(api.getMessage(id)) + all else all
+        }
+        suspend fun action(item: MessageReview, kind: String, text: String = ""): MessageReview {
+            val updated = api.changeMessage(item.id, MessageChange(kind, item.versao, text))
+            items = items.map { if(it.id == updated.id) updated else it }
+            feedback = when(kind) { "preparar_resposta" -> "Rascunho pronto para conferir."; "salvar_rascunho" -> "Rascunho guardado."; else -> "Atualizado." }
+            return updated
+        }
+        LaunchedEffect(filter) { run { load() } }
+        Surface(Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+            Column(Modifier.fillMaxSize().systemBarsPadding().verticalScroll(rememberScrollState()).padding(20.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                    TextButton(onClick = { finish() }) { Text("Voltar") }
+                    TextButton(enabled = !busy, onClick = { run { load() } }) { Text("Atualizar") }
+                }
+                Text("Mensagens para revisar", style = MaterialTheme.typography.headlineMedium)
+                Text("Convites, perguntas e possíveis prazos encontrados nas notificações. Você pode já ter respondido no aplicativo.")
+                Row(Modifier.horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    listOf("revisar" to "Para revisar", "resolvida" to "Resolvidas", "ignorada" to "Ignoradas").forEach { (value, label) ->
+                        FilterChip(enabled = !busy, selected = filter == value, onClick = { selected = null; filter = value }, label = { Text(label) })
+                    }
+                }
+                if(busy) LinearProgressIndicator(Modifier.fillMaxWidth())
+                error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+                feedback?.let { Text(it, color = MaterialTheme.colorScheme.secondary) }
+                if(selected != null) TextButton(onClick = { selected = null }) { Text("Ver todas") }
+                val visible = items.filter { if(selected != null) it.id == selected else it.estado == filter }
+                if(!busy && error == null && visible.isEmpty()) Text("Nenhuma mensagem nessa lista por enquanto.")
+                visible.forEach { item -> key(item.id) {
+                    var draft by remember { mutableStateOf(item.rascunho) }
+                    var instruction by remember { mutableStateOf("") }
+                    Card(Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                            Text(item.remetente, style = MaterialTheme.typography.titleLarge)
+                            Text(item.quando + " · " + item.sinais.joinToString(" · "), color = MaterialTheme.colorScheme.secondary)
+                            Text(item.texto)
+                            if(item.estado == "revisar") {
+                                OutlinedButton(enabled = !busy && item.agenda_id == null, onClick = { run { action(item, "guardar_agenda") } }) { Text(if(item.agenda_id == null) "Guardar compromisso" else "Guardado na agenda") }
+                                OutlinedButton(enabled = !busy && item.tarefa_id == null, onClick = { run { action(item, "criar_tarefa") } }) { Text(if(item.tarefa_id == null) "Criar tarefa" else "Tarefa guardada") }
+                                OutlinedTextField(enabled = !busy, value = instruction, onValueChange = { instruction = it.take(2000) }, label = { Text("O que você quer responder?") }, modifier = Modifier.fillMaxWidth())
+                                Button(enabled = !busy, onClick = { run { draft = action(item, "preparar_resposta", instruction).rascunho } }) { Text("Preparar resposta") }
+                                OutlinedTextField(enabled = !busy, value = draft, onValueChange = { draft = it.take(2000) }, label = { Text("Rascunho para conferir") }, modifier = Modifier.fillMaxWidth())
+                                TextButton(enabled = !busy && draft.isNotBlank(), onClick = { run { draft = action(item, "salvar_rascunho", draft).rascunho } }) { Text("Guardar rascunho") }
+                                OutlinedButton(enabled = draft.isNotBlank(), onClick = {
+                                    try { copy(draft); feedback = "Copiado. Confira o destinatário ao colar na conversa." }
+                                    catch(_: Exception) { error = "Não consegui copiar. Você pode selecionar o texto." }
+                                }) { Text("Copiar rascunho") }
+                                OutlinedButton(enabled = !busy && item.referencia_notificacao.isNotBlank(), onClick = {
+                                    val opened = ListenerDeNotificacoes.abrirConversaRevisada(item.referencia_notificacao, item.pacote, item.remetente)
+                                    if(!opened) error = "A notificação original não está disponível. Abra a conversa no aplicativo e confira o contato."
+                                }) { Text("Abrir conversa original") }
+                                TextButton(enabled = !busy, onClick = { run { action(item, "resolver") } }) { Text("Marcar resolvida") }
+                                TextButton(enabled = !busy, onClick = { run { action(item, "ignorar") } }) { Text("Ignorar") }
+                            } else Text(if(item.estado == "resolvida") "Resolvida" else "Ignorada")
+                            Text("Confira o rascunho e o destinatário. O envio é feito por você na conversa do aplicativo.", style = MaterialTheme.typography.bodySmall)
+                        }
+                    }
+                } }
+            }
+        }
+    }
+}
