+@RunWith(AndroidJUnit4::class)
+class MessagesScreenTest {
+    @get:Rule val compose = createAndroidComposeRule<MessagesActivity>()
+    @Test fun reviewOpensWithoutSendingMessages() {
+        compose.onNodeWithText("Mensagens para revisar").assertIsDisplayed()
+        compose.onNodeWithText("Para revisar").assertIsDisplayed()
+    }
+}
