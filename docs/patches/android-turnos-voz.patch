diff --git a/app/src/test/java/com/example/assistentecell/ConversationTurnTest.kt b/app/src/test/java/com/example/assistentecell/ConversationTurnTest.kt
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/example/assistentecell/ConversationTurnTest.kt
@@ -0,0 +1,42 @@
+package com.example.assistentecell
+
+import com.example.assistentecell.voice.ConversationPhase
+import com.example.assistentecell.voice.ConversationTurn
+import com.example.assistentecell.websocket.ChatBridge
+import org.junit.Assert.*
+import org.junit.Test
+
+class ConversationTurnTest {
+    @Test fun semanticDecisionOverridesPunctuationInEitherDirection() {
+        assertTrue(ConversationTurn.awaitsAnswer("Me diga qual luz", true))
+        assertFalse(ConversationTurn.awaitsAnswer("Qual a sua dúvida?", false))
+    }
+
+    @Test fun oldServerAsksOnlyForADirectClosingQuestion() {
+        listOf("Qual aplicativo você quer abrir?", "A luz está apagada. Quer que eu acenda?",
+            "Posso te fazer uma pergunta?", "**Você prefere música ou vídeo?**", "Como posso ajudar?").forEach {
+            assertTrue(it, ConversationTurn.awaitsAnswer(it, null))
+        }
+    }
+
+    @Test fun finishedAnswersQuotedQuestionsAndLinksNeverReopenCapture() {
+        listOf("A luz está apagada.", "Enviei o pedido para o PC.",
+            "Ela perguntou: ‘Qual aplicativo?’", "O título é Quem é você?",
+            "https://exemplo.com/?", "Como funciona? Funciona assim.").forEach {
+            assertFalse(it, ConversationTurn.awaitsAnswer(it, null))
+        }
+    }
+
+    @Test fun idleIslandCanStayVisibleWhileWakeWordListens() {
+        ChatBridge.updateAssistantSessionStatus(true)
+        ChatBridge.updateAssistantSessionBusy(ConversationPhase.SPEAKING.blocksWakeWord)
+        assertTrue(ChatBridge.isAssistantSessionBusy.value)
+        ChatBridge.updateAssistantSessionBusy(ConversationPhase.READY.blocksWakeWord)
+        assertTrue(ChatBridge.isAssistantSessionActive.value)
+        assertFalse(ChatBridge.isAssistantSessionBusy.value)
+        ChatBridge.updateAssistantSessionBusy(ConversationPhase.LISTENING.blocksWakeWord)
+        ChatBridge.updateAssistantSessionStatus(false)
+        assertFalse(ChatBridge.isAssistantSessionBusy.value)
+        assertFalse(ConversationPhase.ERROR.blocksWakeWord)
+    }
+}
