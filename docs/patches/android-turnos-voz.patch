+package com.example.assistentecell.voice
+
+/** Being visible is distinct from owning an interactive microphone turn. */
+enum class ConversationPhase(val blocksWakeWord: Boolean) {
+    PREPARING(true), LISTENING(true), THINKING(true), SPEAKING(true), READY(false), ERROR(false),
+}
+
+object ConversationTurn {
+    // Compatibility with servers that have not deployed aguarda_resposta yet.
+    // The semantic decision from the server, including false, always wins.
+    private val directQuestion = Regex(
+        "^(?:quer|prefere|posso|poderia|pode|qual|quais|quando|onde|como|quanto|quantos|quantas|" +
+            "o que|mais alguma|tem prefer[eê]ncia|voc[eê] (?:quer|prefere|pode|gostaria|consegue|tem)|" +
+            "would you|do you want|which|what would)\\b", RegexOption.IGNORE_CASE)
+
+    fun awaitsAnswer(text: String, serverDecision: Boolean?): Boolean {
+        if (serverDecision != null) return serverDecision
+        val clean = text.trim().trim('*', '_').trim()
+        if (!clean.endsWith("?")) return false
+        val question = clean.split(Regex("(?<=[.!])\\s+|\\n+"))
+            .last().trim().trimStart('*', '_', '-', ' ')
+        return directQuestion.containsMatchIn(question)
+    }
+}
