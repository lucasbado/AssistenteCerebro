+package com.example.assistentecell
+
+import android.content.Intent
+import androidx.compose.ui.test.assertIsDisplayed
+import androidx.compose.ui.test.assertTextContains
+import androidx.compose.ui.test.junit4.createAndroidComposeRule
+import androidx.compose.ui.test.onNodeWithTag
+import androidx.compose.ui.test.performClick
+import androidx.compose.ui.test.performTextInput
+import androidx.test.espresso.Espresso.pressBack
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import org.junit.Assert.assertFalse
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class NavigationTest {
+    @get:Rule val compose = createAndroidComposeRule<MainActivity>()
+
+    @Test fun tabsOpenChatAndReturnHomeWithoutStackingPages() {
+        listOf("chat", "pc_control", "capabilities", "settings", "chat").forEach { route ->
+            compose.onNodeWithTag("nav-$route").performClick()
+            compose.onNodeWithTag("page-$route").assertIsDisplayed()
+        }
+        // Repeated taps don't stack the same screen; Back returns to Base.
+        compose.onNodeWithTag("nav-chat").performClick()
+        pressBack()
+        compose.onNodeWithTag("page-home").assertIsDisplayed()
+    }
+
+    @Test fun chatIntentWaitsForGraphWhenActivityIsCreated() {
+        compose.activityRule.scenario.onActivity { it.intent.putExtra("target_screen", "chat") }
+        compose.activityRule.scenario.recreate()
+        compose.onNodeWithTag("page-chat").assertIsDisplayed()
+        compose.activityRule.scenario.onActivity { assertFalse(it.intent.hasExtra("target_screen")) }
+    }
+
+    @Test fun chatIntentWorksWhenActivityIsAlreadyOpen() {
+        compose.activityRule.scenario.onActivity {
+            // ActivityScenario matches lifecycle events by the launch intent filter.
+            it.startActivity(Intent(it.intent).addFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP)
+                .putExtra("target_screen", "chat"))
+        }
+        compose.onNodeWithTag("page-chat").assertIsDisplayed()
+    }
+
+    @Test fun draftSurvivesTabChangesAndKeyboardKeepsInputVisible() {
+        compose.onNodeWithTag("nav-chat").performClick()
+        compose.onNodeWithTag("chat-input").performClick().performTextInput("Rascunho")
+        compose.onNodeWithTag("chat-input").assertIsDisplayed()
+        pressBack() // Hide the keyboard before selecting another tab.
+        compose.onNodeWithTag("nav-settings").performClick()
+        compose.onNodeWithTag("nav-chat").performClick()
+        compose.onNodeWithTag("chat-input").assertTextContains("Rascunho")
+    }
+}
diff --git a/app/src/androidTest/java/com/example/assistentecell/OnnxWakeDetectorTest.kt b/app/src/androidTest/java/com/example/assistentecell/OnnxWakeDetectorTest.kt
