@@ -0,0 +1,84 @@
+package com.example.assistentecell.voice
+
+import android.annotation.SuppressLint
+import android.media.AudioFormat
+import android.media.AudioRecord
+import android.media.MediaRecorder
+import android.os.SystemClock
+import android.util.Log
+import kotlin.math.sqrt
+
+/** Owns just the wake microphone. stop() yields it before the assistant starts STT. */
+class WakeWordRecorder(
+    private val detector: OnnxWakeDetector,
+    private val onReady: () -> Unit,
+    private val onScore: (Float, Long) -> Unit,
+    private val onError: () -> Unit,
+) : AutoCloseable {
+    @Volatile private var running = false
+    private var recorder: AudioRecord? = null
+    private var thread: Thread? = null
+
+    @SuppressLint("MissingPermission")
+    fun start() {
+        check(!running)
+        detector.reset()
+        val minimum = AudioRecord.getMinBufferSize(OnnxWakeDetector.RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT)
+        require(minimum > 0)
+        val audio = AudioRecord(MediaRecorder.AudioSource.VOICE_RECOGNITION, OnnxWakeDetector.RATE,
+            AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT, maxOf(minimum, OnnxWakeDetector.FRAME * 8))
+        if (audio.state != AudioRecord.STATE_INITIALIZED) { audio.release(); error("Microfone indisponivel") }
+        try { audio.startRecording() } catch (error: Throwable) { audio.release(); throw error }
+        recorder = audio
+        running = true
+        thread = Thread({
+            try {
+                val frame = ShortArray(OnnxWakeDetector.FRAME)
+                var offset = 0
+                var ready = false
+                var lastStats = SystemClock.elapsedRealtime()
+                var peakScore = 0f
+                var peakLevel = 0.0
+                while (running) {
+                    val count = audio.read(frame, offset, frame.size - offset, AudioRecord.READ_BLOCKING)
+                    if (!running) break
+                    check(count > 0) { "Captura interrompida" }
+                    offset += count
+                    if (offset != frame.size) continue
+                    val score = detector.predict(frame)
+                    val now = SystemClock.elapsedRealtime()
+                    val level = sqrt(frame.sumOf { it.toDouble() * it } / frame.size) / 32768.0
+                    peakScore = maxOf(peakScore, score)
+                    peakLevel = maxOf(peakLevel, level)
+                    if (now - lastStats >= 5000) {
+                        // Numeric diagnostics only: no samples, words or recordings are logged.
+                        Log.d("WakeWordAudio", "peak=$peakScore rms=$peakLevel")
+                        peakScore = 0f; peakLevel = 0.0; lastStats = now
+                    }
+                    offset = 0
+                    if (!ready && detector.ready) { ready = true; onReady() }
+                    if (running && ready) onScore(score, now)
+                }
+            } catch (error: Exception) {
+                if (running) {
+                    Log.w("WakeWordAudio", "Capture failed: ${error.javaClass.simpleName}")
+                    onError()
+                }
+            } finally {
+                running = false
+                try { audio.stop() } catch (_: Exception) { }
+                audio.release()
+            }
+        }, "OllieWakeWord").also { it.start() }
+    }
+
+    override fun close() {
+        running = false
+        // stop() interrupts a blocking read and releases active microphone capture now.
+        try { recorder?.stop() } catch (_: Exception) { }
+        val previous = thread
+        if (previous != null && previous !== Thread.currentThread()) previous.join(500)
+        thread = null
+        recorder = null
+    }
+}
