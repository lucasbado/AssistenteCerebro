+    private var count = 0
+    private var armed = true
+    fun reset() { count = 0; armed = true }
+    fun accept(score: Float, blocked: Boolean, now: Long): Boolean {
+        if (blocked || !score.isFinite() || score < .5f) {
+            reset()
+            return false
+        }
+        count = (count + 1).coerceAtMost(2)
+        if (!armed || count < 2 || last?.let { now - it < 5000 } == true) return false
         last = now
+        armed = false
         return true
     }
 }
