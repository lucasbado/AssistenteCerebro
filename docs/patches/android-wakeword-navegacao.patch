--- /dev/null
+++ b/app/src/androidTest/java/com/example/assistentecell/OnnxWakeDetectorTest.kt
@@ -0,0 +1,55 @@
+package com.example.assistentecell
+
+import android.os.SystemClock
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.example.assistentecell.voice.OnnxWakeDetector
+import com.example.assistentecell.voice.WakeWordGate
+import org.json.JSONArray
+import org.json.JSONObject
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.abs
+
+@RunWith(AndroidJUnit4::class)
+class OnnxWakeDetectorTest {
+    @Test fun androidScoresMatchPythonAndRejectSimilarPhrases() {
+        val instrumentation = InstrumentationRegistry.getInstrumentation()
+        val app = instrumentation.targetContext
+        val fixtures = instrumentation.context.assets
+        val cases = JSONArray(fixtures.open("wakeword-fixtures/expected.json").bufferedReader().use { it.readText() })
+        val reports = JSONArray()
+        OnnxWakeDetector.load { name -> app.assets.open("wakeword/$name").use { it.readBytes() } }.use { detector ->
+            for (i in 0 until cases.length()) {
+                val fixture = cases.getJSONObject(i)
+                val bytes = fixtures.open("wakeword-fixtures/${fixture.getString("file")}").use { it.readBytes() }
+                val source = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN).asShortBuffer()
+                val expected = fixture.getJSONArray("scores")
+                val gate = WakeWordGate()
+                val durations = mutableListOf<Double>()
+                detector.reset()
+                var hits = 0
+                var error = 0f
+                for (frameIndex in 0 until expected.length()) {
+                    val frame = ShortArray(OnnxWakeDetector.FRAME)
+                    source.get(frame)
+                    val start = SystemClock.elapsedRealtimeNanos()
+                    val score = detector.predict(frame)
+                    durations.add((SystemClock.elapsedRealtimeNanos() - start) / 1e6)
+                    error = maxOf(error, abs(score - expected.getDouble(frameIndex).toFloat()))
+                    if (gate.accept(score, false, (frameIndex + 1) * 80L)) hits++
+                }
+                assertTrue("Python/Android drift ${fixture.getString("file")}: $error", error < .002f)
+                assertEquals(fixture.getString("file"), fixture.getInt("hits"), hits)
+                val ordered = durations.sorted()
+                reports.put(JSONObject().put("file", fixture.getString("file")).put("hits", hits)
+                    .put("max_score_error", error).put("median_ms", ordered[ordered.size / 2]).put("max_ms", ordered.last()))
+            }
+        }
+        File(app.filesDir, "wakeword-validation.json").writeText(reports.toString(2))
+    }
+}
