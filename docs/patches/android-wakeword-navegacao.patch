+++ b/app/src/main/java/com/example/assistentecell/voice/OnnxWakeDetector.kt
@@ -0,0 +1,109 @@
+package com.example.assistentecell.voice
+
+import ai.onnxruntime.OnnxTensor
+import ai.onnxruntime.OrtEnvironment
+import ai.onnxruntime.OrtSession
+import java.io.ByteArrayInputStream
+import java.nio.FloatBuffer
+import java.security.MessageDigest
+import java.util.Properties
+
+/** Streaming PCM16/16kHz, with the same mel -> embedding -> head path as openWakeWord 0.6. */
+class OnnxWakeDetector(melBytes: ByteArray, embeddingBytes: ByteArray, headBytes: ByteArray) : AutoCloseable {
+    companion object {
+        const val FRAME = 1280
+        const val RATE = 16000
+        const val WARMUP_FRAMES = 32
+        val files = listOf("melspectrogram.onnx", "embedding_model.onnx", "hey_ollie.onnx")
+
+        fun load(read: (String) -> ByteArray): OnnxWakeDetector {
+            val hashes = Properties().apply { load(ByteArrayInputStream(read("models.properties"))) }
+            val models = files.map { name ->
+                read(name).also { bytes ->
+                    val actual = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+                    require(actual == hashes.getProperty(name)) { "Modelo de ativacao incompleto: $name" }
+                }
+            }
+            return OnnxWakeDetector(models[0], models[1], models[2])
+        }
+    }
+
+    private val environment = OrtEnvironment.getEnvironment()
+    private val options = OrtSession.SessionOptions().apply {
+        setIntraOpNumThreads(1)
+        setInterOpNumThreads(1)
+    }
+    private val sessions = mutableListOf<OrtSession>()
+    private val mel: OrtSession
+    private val embedding: OrtSession
+    private val head: OrtSession
+    private var tail = FloatArray(0)
+    private val mels = FloatArray(76 * 32) { 1f }
+    private val embeddings = FloatArray(16 * 96)
+    private var frames = 0
+    private var closed = false
+    val ready: Boolean get() = frames >= WARMUP_FRAMES
+
+    init {
+        try {
+            mel = environment.createSession(melBytes, options).also { sessions.add(it) }
+            embedding = environment.createSession(embeddingBytes, options).also { sessions.add(it) }
+            head = environment.createSession(headBytes, options).also { sessions.add(it) }
+        } catch (error: Throwable) {
+            sessions.forEach { it.close() }
+            options.close()
+            throw error
+        }
+    }
+
+    @Synchronized fun reset() {
+        check(!closed)
+        tail = FloatArray(0)
+        mels.fill(1f)
+        embeddings.fill(0f)
+        frames = 0
+    }
+
+    private fun infer(session: OrtSession, inputName: String, values: FloatArray, shape: LongArray): FloatArray {
+        OnnxTensor.createTensor(environment, FloatBuffer.wrap(values), shape).use { input ->
+            session.run(mapOf(inputName to input)).use { output ->
+                val buffer = (output[0] as OnnxTensor).floatBuffer
+                return FloatArray(buffer.remaining()).also { buffer.get(it) }
+            }
+        }
+    }
+
+    private fun append(buffer: FloatArray, values: FloatArray) {
+        require(values.size <= buffer.size)
+        buffer.copyInto(buffer, 0, values.size, buffer.size)
+        values.copyInto(buffer, buffer.size - values.size)
+    }
+
+    @Synchronized fun predict(pcm: ShortArray): Float {
+        check(!closed)
+        require(pcm.size == FRAME)
+        // The mel graph expects raw int16 amplitudes represented as float, not [-1,1].
+        val audio = FloatArray(tail.size + FRAME)
+        tail.copyInto(audio)
+        for (i in pcm.indices) audio[tail.size + i] = pcm[i].toFloat()
+        tail = audio.copyOfRange(audio.size - 480, audio.size)
+        val spectrum = infer(mel, "input", audio, longArrayOf(1, audio.size.toLong()))
+        require(spectrum.size % 32 == 0)
+        for (i in spectrum.indices) spectrum[i] = spectrum[i] / 10f + 2f
+        append(mels, spectrum)
+        val vector = infer(embedding, "input_1", mels, longArrayOf(1, 76, 32, 1))
+        require(vector.size == 96)
+        append(embeddings, vector)
+        val score = infer(head, "input", embeddings, longArrayOf(1, 16, 96)).single()
+        frames++
+        // After warm-up all initialized history has been replaced with real audio.
+        return if (ready && score.isFinite()) score else 0f
+    }
+
+    @Synchronized override fun close() {
+        if (closed) return
+        closed = true
+        sessions.reversed().forEach { it.close() }
+        options.close()
+    }
+}
