+package com.example.assistentecell.command
+
+import android.Manifest
+import android.app.NotificationManager
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Bundle
+import android.provider.Settings
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.core.content.ContextCompat
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import com.example.assistentecell.accessibility.OllieAccessibilityService
+import com.example.assistentecell.ui.theme.AssistenteCellTheme
+
+class DeviceControlsActivity: ComponentActivity() {
+    private var permissionRevision by mutableIntStateOf(0)
+    private val permission = registerForActivityResult(ActivityResultContracts.RequestPermission()) { permissionRevision++ }
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContent { AssistenteCellTheme(darkTheme = true, dynamicColor = false) { Controls() } }
+    }
+
+    @Composable private fun Controls() {
+        var revision by remember { mutableIntStateOf(0) }
+        DisposableEffect(Unit) {
+            val observer = LifecycleEventObserver { _, event -> if(event == Lifecycle.Event.ON_RESUME) revision++ }
+            lifecycle.addObserver(observer)
+            onDispose { lifecycle.removeObserver(observer) }
+        }
+        val camera = (revision + permissionRevision).let { ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA) == PackageManager.PERMISSION_GRANTED }
+        val contacts = (revision + permissionRevision).let { ContextCompat.checkSelfPermission(this, Manifest.permission.READ_CONTACTS) == PackageManager.PERMISSION_GRANTED }
+        val write = revision.let { Settings.System.canWrite(this) }
+        val policy = revision.let { getSystemService(NotificationManager::class.java).isNotificationPolicyAccessGranted }
+        val access = revision.let { OllieAccessibilityService.getInstance() != null }
+        Surface(Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+            Column(Modifier.safeDrawingPadding().padding(24.dp).verticalScroll(rememberScrollState()), verticalArrangement = Arrangement.spacedBy(16.dp)) {
+                TextButton(onClick = { finish() }) { Text("Voltar") }
+                Text("Controles do celular", style = MaterialTheme.typography.headlineMedium)
+                Text("A Ollie executa seus pedidos e informa quando precisa de uma permissão ou de um toque seu.", color = MaterialTheme.colorScheme.onSurfaceVariant)
+                ControlCard("Lanterna", camera, "Autorizar câmera") { permission.launch(Manifest.permission.CAMERA) }
+                ControlCard("Brilho", write, "Permitir ajustes do sistema") {
+                    startActivity(Intent(Settings.ACTION_MANAGE_WRITE_SETTINGS, Uri.parse("package:$packageName")))
+                }
+                ControlCard("Som e Não perturbe", policy, "Autorizar Não perturbe") {
+                    startActivity(Intent(Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS))
+                }
+                ControlCard("Navegação entre telas", access, "Abrir acessibilidade") { startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS)) }
+                ControlCard("Contatos para WhatsApp", contacts, "Autorizar contatos") { permission.launch(Manifest.permission.READ_CONTACTS) }
+                Card {
+                    Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                        Text("Experimente por voz", style = MaterialTheme.typography.titleMedium)
+                        Text("Ligue a lanterna\nColoque o volume de mídia em 40%\nColoque o celular no modo vibrar\nCrie um timer de 5 minutos\nColoque um despertador para 7:30\nAtive o GPS")
+                        Text("Wi-Fi, Bluetooth e localização abrem os ajustes do Android. Alarmes e timers são encaminhados ao relógio; confira-os por lá.", style = MaterialTheme.typography.bodySmall)
+                    }
+                }
+                Card {
+                    Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                        Text("Mensagens com revisão", style = MaterialTheme.typography.titleMedium)
+                        Text("Mande mensagem para Ana no WhatsApp dizendo chego às oito")
+                        Text("Você confere o destinatário e toca para enviar. Com uma notificação ativa que permita resposta, a Ollie pode responder pelo próprio app. Para uma conversa nova no WhatsApp, ela abre o texto no aplicativo. Instagram sem notificação exige abrir a conversa manualmente.", style = MaterialTheme.typography.bodySmall)
+                        OutlinedButton(onClick = { startActivity(Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS)) }) { Text("Conferir acesso a notificações") }
+                    }
+                }
+            }
+        }
+    }
+
+    @Composable private fun ControlCard(title: String, granted: Boolean, action: String, click: () -> Unit) {
+        Card { Column(Modifier.fillMaxWidth().padding(16.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            Text(title, style = MaterialTheme.typography.titleMedium)
+            Text(if(granted) "Disponível" else "Precisa de autorização", color = MaterialTheme.colorScheme.secondary)
+            OutlinedButton(onClick = click) { Text(action) }
+        } }
+    }
+}
diff --git a/app/src/main/java/com/example/assistentecell/command/MessageRecipientPolicy.kt b/app/src/main/java/com/example/assistentecell/command/MessageRecipientPolicy.kt
