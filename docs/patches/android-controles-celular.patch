@@ -0,0 +1,53 @@
+package com.example.assistentecell.command
+
+import com.google.gson.JsonObject
+import com.google.gson.Gson
+import java.security.MessageDigest
+
+data class MobileControlRequest(val id: String, val action: String, val args: JsonObject) {
+    val digest: String get() = MessageDigest.getInstance("SHA-256")
+        .digest((action + args.toString()).toByteArray()).joinToString("") { "%02x".format(it) }
+    fun number(key: String) = args[key].asInt
+    fun text(key: String) = args[key].asString
+    fun flag(key: String) = args[key].asBoolean
+
+    companion object {
+        fun parse(raw: String): MobileControlRequest {
+            require(raw.length <= 10000)
+            val obj = Gson().fromJson(raw, JsonObject::class.java)
+            require(obj["pedido_usuario"]?.isJsonPrimitive == true && obj["pedido_usuario"].asJsonPrimitive.isBoolean && obj["pedido_usuario"].asBoolean)
+            val id = obj["id_comando"]?.asString.orEmpty()
+            require(obj["id_comando"]?.asJsonPrimitive?.isString == true)
+            require(id.matches(Regex("[\\w.:-]{1,128}")))
+            val action = obj["acao"]?.asString.orEmpty()
+            val p = obj["parametros"]?.asJsonObject ?: error("Parâmetros ausentes")
+            fun keys(vararg keys: String) { require(p.entrySet().map { it.key }.toSet() == keys.toSet()) }
+            fun int(key: String, range: IntRange) {
+                val v = p[key]?.asJsonPrimitive ?: error("Número ausente")
+                val number = v.toString().takeIf { v.isNumber && it.matches(Regex("\\d+")) }?.toLongOrNull()
+                require(number != null && number in range.first.toLong()..range.last.toLong())
+            }
+            fun text(key: String, values: Set<String>) { require(p[key]?.asJsonPrimitive?.isString == true && p[key].asString in values) }
+            fun flag(key: String) { require(p[key]?.asJsonPrimitive?.isBoolean == true) }
+            when(action) {
+                "flashlight.set", "dnd.set" -> { keys("estado"); flag("estado") }
+                "volume.set" -> { keys("valor", "canal"); int("valor", 0..100); text("canal", setOf("media", "alarm", "ring", "notification")) }
+                "brightness.set" -> { keys("valor"); int("valor", 0..100) }
+                "sound.mode" -> { keys("modo"); text("modo", setOf("silent", "vibrate", "normal")) }
+                "timer.create" -> { keys("segundos"); int("segundos", 1..86400) }
+                "alarm.create" -> { keys("hora", "minuto"); int("hora", 0..23); int("minuto", 0..59) }
+                "navigation" -> { keys("destino"); text("destino", setOf("back", "home", "recents", "notifications")) }
+                "settings.open" -> { keys("painel", "estado_desejado"); text("painel", setOf("location", "wifi", "bluetooth")); flag("estado_desejado") }
+                "controls.open" -> keys()
+                "message.prepare" -> {
+                    keys("app", "destinatario", "texto"); text("app", setOf("whatsapp", "instagram"))
+                    for ((key, max) in listOf("destinatario" to 100, "texto" to 2000)) {
+                        require(p[key]?.asJsonPrimitive?.isString == true && p[key].asString.trim().length in 1..max)
+                    }
+                }
+                else -> error("Controle desconhecido")
+            }
+            return MobileControlRequest(id, action, p)
+        }
+    }
+}
