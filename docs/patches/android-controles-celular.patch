diff --git a/app/src/test/java/com/example/assistentecell/MobileControlRequestTest.kt b/app/src/test/java/com/example/assistentecell/MobileControlRequestTest.kt
new file mode 100644
--- /dev/null
+++ b/app/src/test/java/com/example/assistentecell/MobileControlRequestTest.kt
@@ -0,0 +1,45 @@
+package com.example.assistentecell
+
+import com.example.assistentecell.command.MobileControlRequest
+import com.example.assistentecell.command.MessageRecipientPolicy
+import org.junit.Assert.*
+import org.junit.Test
+
+class MobileControlRequestTest {
+    private fun parse(action: String, args: String, authorized: String = "true") = MobileControlRequest.parse(
+        """{"id_comando":"pedido-1","pedido_usuario":$authorized,"acao":"$action","parametros":$args}""")
+    @Test fun preservesFalseZeroAndExactMessage() {
+        assertFalse(parse("dnd.set", """{"estado":false}""").flag("estado"))
+        assertEquals(0, parse("volume.set", """{"canal":"media","valor":0}""").number("valor"))
+        val message = parse("message.prepare", """{"app":"instagram","destinatario":"João","texto":"Não abra https://example.com/Case?A=B"}""")
+        assertEquals("Não abra https://example.com/Case?A=B", message.text("texto"))
+        assertEquals(message.digest, parse("message.prepare", message.args.toString()).digest)
+    }
+    @Test fun rejectsCoercionUnknownAndUnconfirmedActions() {
+        for ((action, args) in listOf(
+            "volume.set" to """{"canal":"media","valor":"50"}""",
+            "volume.set" to """{"canal":"media","valor":101}""",
+            "volume.set" to """{"canal":"media","valor":1.0}""",
+            "volume.set" to """{"canal":"media","valor":4294967296}""",
+            "flashlight.set" to """{"estado":"false"}""",
+            "flashlight.set" to """{"estado":1}""",
+            "timer.create" to """{"segundos":0}""",
+            "timer.create" to """{"segundos":86401}""",
+            "alarm.create" to """{"hora":24,"minuto":0}""",
+            "brightness.set" to """{"valor":50,"shell":"ls"}""",
+            "message.send" to """{"texto":"oi"}""",
+            "message.prepare" to """{"app":"whatsapp","destinatario":"","texto":"oi"}"""
+        )) { try { parse(action, args); fail("Deveria recusar $action $args") } catch (_: Exception) {} }
+        for(auth in listOf("false", "\"true\"", "1")) {
+            try { parse("flashlight.set", """{"estado":true}""", auth); fail("Autoridade inválida") } catch (_: Exception) {}
+        }
+    }
+    @Test fun exactRecipientNeverMatchesGroupSubstringOrTwoNumbers() {
+        assertTrue(MessageRecipientPolicy.matches("João", "joao", false))
+        assertFalse(MessageRecipientPolicy.matches("Ana", "Ana Trabalho", false))
+        assertFalse(MessageRecipientPolicy.matches("Família", "Família", true))
+        assertFalse(MessageRecipientPolicy.matches("", "", false))
+        assertNull(MessageRecipientPolicy.uniquePhone(listOf("5511999999999", "5511888888888")))
+        assertEquals("5511999999999", MessageRecipientPolicy.uniquePhone(listOf("5511999999999", "5511999999999")))
+    }
+}
