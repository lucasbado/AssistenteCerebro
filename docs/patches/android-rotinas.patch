+package com.example.assistentecell
+
+import com.example.assistentecell.network.BackendAuthInterceptor
+import com.example.assistentecell.network.BackendChatTransport
+import com.google.gson.Gson
+import com.google.gson.JsonObject
+import java.io.IOException
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicReference
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import okio.Buffer
+import org.junit.Assert.*
+import org.junit.Test
+
+class BackendChatTransportTest {
+    private fun send(transport: BackendChatTransport): Int {
+        val done = CountDownLatch(1)
+        val code = AtomicInteger(-1)
+        val error = AtomicReference<IOException>()
+        transport.enqueue("Olá, Ollie!", "com.example.assistentecell.chat", object : Callback {
+            override fun onFailure(call: Call, e: IOException) { error.set(e); done.countDown() }
+            override fun onResponse(call: Call, response: Response) {
+                response.use { code.set(it.code) }; done.countDown()
+            }
+        }, correlationId = "voice-request-123")
+        assertTrue(done.await(3, TimeUnit.SECONDS))
+        assertNull(error.get())
+        return code.get()
+    }
+
+    @Test fun chatIncludesAuthenticationAndCanonicalEvent() {
+        val received = AtomicReference<Request>()
+        val client = OkHttpClient.Builder()
+            .addInterceptor(BackendAuthInterceptor({ "https://example.test/" }, { "example-token" }))
+            .addInterceptor { chain ->
+                received.set(chain.request())
+                Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1)
+                    .code(202).message("Accepted").body("{}".toResponseBody()).build()
+            }.build()
+        try {
+            assertEquals(202, send(BackendChatTransport(client) { "https://example.test/" }))
+            val request = received.get()
+            assertEquals("POST", request.method)
+            assertEquals("/eventos", request.url.encodedPath)
+            assertEquals("Bearer example-token", request.header("Authorization"))
+            val buffer = Buffer()
+            request.body!!.writeTo(buffer)
+            val event = Gson().fromJson(buffer.readUtf8(), JsonObject::class.java)
+            assertEquals("SISTEMA_COMANDO_USUARIO", event["categoria"].asString)
+            assertEquals("voice-request-123", event["correlacao_id"].asString)
+            assertEquals("com.example.assistentecell.chat", event["pacote"].asString)
+            assertEquals("Olá, Ollie!", event["payload"].asJsonObject["texto"].asString)
+        } finally { client.dispatcher.executorService.shutdownNow() }
+    }
+
+    @Test fun rejectsAreReportedAndUrlChangesAreUsed() {
+        var server = "https://old.example.test/"
+        val received = AtomicReference<Request>()
+        val client = OkHttpClient.Builder()
+            .addInterceptor(BackendAuthInterceptor({ server }, { "example-token" }))
+            .addInterceptor { chain ->
+                received.set(chain.request())
+                Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1)
+                    .code(401).message("Unauthorized").body("{}".toResponseBody()).build()
+            }.build()
+        try {
+            val transport = BackendChatTransport(client) { server }
+            server = "https://new.example.test/"
+            assertEquals(401, send(transport))
+            assertEquals("new.example.test", received.get().url.host)
+            assertEquals("Bearer example-token", received.get().header("Authorization"))
+            assertTrue(BackendChatTransport.failureMessage(401)!!.contains("token"))
+            assertNotNull(BackendChatTransport.failureMessage(503))
+            assertNull(BackendChatTransport.failureMessage(202))
+        } finally { client.dispatcher.executorService.shutdownNow() }
+    }
+}
