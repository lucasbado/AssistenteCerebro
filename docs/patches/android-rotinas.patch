+            assertEquals("Luz apagada & pronto", received!!.url.queryParameter("text"))
+            assertFalse(received!!.url.toString().contains("test-token"))
+            assertArrayEquals(byteArrayOf(1, 2, 3), file.readBytes())
+        } finally { file.delete(); client.dispatcher.executorService.shutdownNow() }
+    }
+
+    @Test fun refusesAuthenticationErrorsAndNonAudioResponses() {
+        for (code in listOf(401, 200)) {
+            val client = OkHttpClient.Builder().addInterceptor {
+                Response.Builder().request(it.request()).protocol(Protocol.HTTP_1_1).code(code).message("Test")
+                    .body("{}".toResponseBody("application/json".toMediaType())).build()
+            }.build()
+            val file = File.createTempFile("voice-test", ".mp3")
+            try {
+                try { BackendVoiceTransport(client) { "https://example.test/" }.download("Teste", 1f, 1f, file)
+                    fail("Resposta deve ser recusada")
+                } catch (_: IOException) {}
+            } finally { file.delete(); client.dispatcher.executorService.shutdownNow() }
+        }
+    }
+}
--- a/app/src/test/java/com/example/assistentecell/HomeAssistantLightControllerTest.kt
+++ b/app/src/test/java/com/example/assistentecell/HomeAssistantLightControllerTest.kt
@@ -0,0 +1,85 @@
+package com.example.assistentecell
+
+import com.example.assistentecell.data.HomeAssistantLightController
+import com.example.assistentecell.data.HouseLightResolver
+import com.example.assistentecell.data.api.HomeAssistantApiService
+import com.example.assistentecell.data.model.HAEntity
+import kotlinx.coroutines.*
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.Assert.*
+import org.junit.Test
+import retrofit2.Response
+import java.io.IOException
+
+class HomeAssistantLightControllerTest {
+    private class FakeApi(var current: String = "on", var applyAction: Boolean = true) : HomeAssistantApiService {
+        val id = "light.yeelink_color5_027d_light"
+        val posts = mutableListOf<Pair<String, Map<String, Any>>>()
+        fun light() = HAEntity(id, current, mapOf("friendly_name" to "luz quarto Light"), null)
+        override suspend fun getStates(token: String) = Response.success(listOf(light()))
+        override suspend fun getEntityState(token: String, entityId: String): Response<HAEntity> {
+            delay(2)
+            return if (entityId == id) Response.success(light()) else Response.error(404, "{}".toResponseBody())
+        }
+        override suspend fun callService(token: String, domain: String, service: String, body: Map<String, Any>): Response<List<HAEntity>> {
+            assertEquals("light", domain)
+            assertEquals(id, body["entity_id"])
+            posts.add(service to body)
+            if (applyAction) current = if (service == "turn_on") "on" else "off"
+            return Response.success(emptyList())
+        }
+    }
+
+    @Test fun roomNameResolvesRealEntityAndUnknownRoomIsRejected() {
+        val api = FakeApi()
+        assertEquals(api.id, HouseLightResolver.resolve("quarto", listOf(api.light())).entityId)
+        try { HouseLightResolver.resolve("sala", listOf(api.light())); fail("Não inventar luz da sala") }
+        catch (_: IllegalArgumentException) {}
+        try { HouseLightResolver.resolve("light.luz_quarto", listOf(api.light())); fail("Não aceitar entidade inexistente") }
+        catch (_: IllegalArgumentException) {}
+    }
+
+    @Test fun ambiguousNameDoesNotChooseFirstLight() {
+        val api = FakeApi()
+        val other = api.light().copy(entityId = "light.outra")
+        try { HouseLightResolver.resolve("quarto", listOf(api.light(), other)); fail("Nome ambíguo") }
+        catch (_: IllegalArgumentException) {}
+    }
+
+    @Test fun toggleSendsOneExplicitActionAndConfirmsState() = runBlocking {
+        val api = FakeApi()
+        val result = HomeAssistantLightController(api).execute("token", "alternar", api.id)
+        assertEquals("off", result.state)
+        assertEquals(1, api.posts.size)
+        assertEquals("turn_off", api.posts.single().first)
+    }
+
+    @Test fun acceptedRequestWithoutStateChangeIsFailure() = runBlocking {
+        val api = FakeApi(applyAction = false)
+        try { HomeAssistantLightController(api).execute("token", "alternar", api.id); fail("Não declarar sucesso por HTTP 200") }
+        catch (e: IOException) { assertTrue(e.message!!.contains("não confirmou")) }
+        assertEquals(1, api.posts.size)
+    }
+
+    @Test fun nonexistentEntityIsRejectedBeforeCallingService() = runBlocking {
+        val api = FakeApi()
+        try { HomeAssistantLightController(api).execute("token", "alternar", "light.luz_quarto"); fail("Não acionar entidade inexistente") }
+        catch (_: IOException) {}
+        assertTrue(api.posts.isEmpty())
+    }
+
+    @Test fun unavailableLightDoesNotReceiveServiceCall() = runBlocking {
+        val api = FakeApi(current = "unavailable")
+        try { HomeAssistantLightController(api).execute("token", "alternar", api.id); fail("Luz indisponível") }
+        catch (_: IOException) {}
+        assertTrue(api.posts.isEmpty())
+    }
+
+    @Test fun concurrentTogglesAreSerializedAcrossControllerInstances() = runBlocking {
+        val api = FakeApi()
+        awaitAll(async { HomeAssistantLightController(api).execute("token", "alternar", api.id) },
+                 async { HomeAssistantLightController(api).execute("token", "alternar", api.id) })
+        assertEquals("on", api.current)
+        assertEquals(listOf("turn_off", "turn_on"), api.posts.map { it.first })
+    }
+}
