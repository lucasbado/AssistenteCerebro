@@ -0,0 +1,42 @@
+package com.example.assistentecell.automation
+
+import com.example.assistentecell.data.model.ApiRoutine
+import com.example.assistentecell.data.model.RoutineAction
+
+/** Presentation of the real trigger/actions, including old server records. */
+object RoutineDescription {
+    fun trigger(routine: ApiRoutine, label: (String) -> String = { it }): String {
+        val g = routine.gatilho ?: return "Gatilho não informado"
+        return when (g.tipo) {
+            "APP_OPENED" -> "Ao abrir ${label(g.pacote.orEmpty())} no celular"
+            "PC_ACTIVITY" -> "Ao usar ${label(g.processo.orEmpty())} no PC"
+            "TIME_RANGE" -> "Entre ${g.inicio} e ${g.fim}" + if (g.evento == "PC_ACTIVITY") ", enquanto usa o PC" else ""
+            else -> "Gatilho precisa de revisão"
+        }
+    }
+
+    fun action(action: RoutineAction, label: (String) -> String = { it }): String {
+        val command = action.comando.uppercase()
+        val value = action.parametro
+        return when {
+            action.alvo == "IA" -> "Avisar: $value" + (action.acao_texto?.let { " (botão: $it)" } ?: "")
+            command in setOf("OPEN_APP", "ABRIR_APP", "ABRIR_APP_MOBILE", "LAUNCH_APP") ->
+                "Abrir ${label(value)} ${if (action.alvo == "PC") "no PC" else "no celular"}"
+            action.alvo == "PC" && command.endsWith(".EXE") && value.isBlank() -> "Abrir ${label(action.comando)} no PC"
+            action.alvo == "CASA" -> "${action.comando.replace('_', ' ')}: $value"
+            else -> "${action.alvo}: ${action.comando.replace('_', ' ')}${if (value.isBlank()) "" else " — $value"}"
+        }
+    }
+
+    fun fromLegacy(rule: com.example.assistentecell.data.model.AutomationRule): ApiRoutine {
+        val command = rule.actionParameter
+        val pcApps = setOf("vscode", "android_studio", "spotify", "discord", "lol", "pasta_jogos")
+        val action = if (rule.actionType == "PC_COMMAND") {
+            if (command in pcApps) RoutineAction("PC", "abrir_app", command)
+            else RoutineAction("PC", if (command == "dormir_pc") "hibernar_pc" else command)
+        } else RoutineAction("MOBILE", "OPEN_APP", command)
+        return ApiRoutine(nome = rule.nome ?: "Ao abrir ${rule.triggerPackage}",
+            gatilho = com.example.assistentecell.data.model.RoutineTrigger("APP_OPENED", pacote = rule.triggerPackage),
+            acoes = listOf(action), ativa = false)
+    }
+}
