@@ -0,0 +1,45 @@
+package com.example.assistentecell.command
+
+import android.content.Context
+import com.example.assistentecell.api.RetrofitClient
+import com.example.assistentecell.network.HouseCommand
+import kotlinx.coroutines.*
+import org.json.JSONObject
+import java.io.IOException
+
+/** Ponte de execução: recebe uma entidade exata e devolve o estado confirmado à Ollie. */
+object HouseCommandExecutor {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val results = linkedMapOf<String, Deferred<JSONObject>>()
+
+    fun execute(context: Context, message: JSONObject, reply: (String) -> Boolean) {
+        val command = runCatching { HouseCommand.parse(message.toString()) }.getOrElse { return }
+        scope.launch {
+            val pending = synchronized(results) {
+                results[command.id] ?: scope.async {
+                    try {
+                        val state = withTimeout(15000) { executeLight(context.applicationContext, command) }
+                        JSONObject().put("tipo_ws", "CASA_RESULTADO").put("id_comando", command.id)
+                            .put("status", "concluido")
+                            .put("resultado", JSONObject().put("entity_id", command.entityId).put("state", state))
+                    } catch (_: Exception) {
+                        JSONObject().put("tipo_ws", "CASA_RESULTADO").put("id_comando", command.id).put("status", "erro")
+                    }
+                }.also { job ->
+                    if (results.size >= 200) results.entries.removeAll { it.value.isCompleted }
+                    results[command.id] = job
+                }
+            }
+            val result = pending.await()
+            android.util.Log.i("OllieCasa", "id=${command.id} status=${result.optString("status")}")
+            reply(result.toString())
+        }
+    }
+
+    private suspend fun executeLight(context: Context, command: HouseCommand): String {
+        val token = context.getSharedPreferences("sistema_prefs", Context.MODE_PRIVATE).getString("ha_token", "").orEmpty()
+        if (token.isBlank()) throw IOException("Home Assistant não configurado")
+        return com.example.assistentecell.data.HomeAssistantLightController(RetrofitClient.haApiService)
+            .execute(token, command.action, command.entityId).state
+    }
+}
