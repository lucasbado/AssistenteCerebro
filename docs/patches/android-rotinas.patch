@@ -0,0 +1,24 @@
+package com.example.assistentecell.network
+
+import okhttp3.HttpUrl.Companion.toHttpUrl
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.File
+import java.io.IOException
+
+/** Usa o mesmo cliente autenticado do chat, sem colocar credenciais na URL do áudio. */
+class BackendVoiceTransport(private val client: OkHttpClient, private val baseUrl: () -> String) {
+    fun download(text: String, rate: Float, pitch: Float, destination: File) {
+        val url = baseUrl().toHttpUrl().newBuilder()
+            .addPathSegments("api/v1/voice/speak")
+            .addQueryParameter("text", text).addQueryParameter("rate", rate.toString())
+            .addQueryParameter("pitch", pitch.toString()).build()
+        client.newCall(Request.Builder().url(url).build()).execute().use { response ->
+            if (!response.isSuccessful) throw IOException("Voz recusada: HTTP ${response.code}")
+            val body = response.body ?: throw IOException("Áudio ausente")
+            if (body.contentType()?.type != "audio") throw IOException("Resposta sem áudio")
+            body.byteStream().use { input -> destination.outputStream().use { input.copyTo(it) } }
+            if (destination.length() == 0L) throw IOException("Áudio vazio")
+        }
+    }
+}
