+package com.example.assistentecell.voice
+
+/** Only a reply to an explicit microphone request overrides automatic read-aloud. */
+class VoiceReplyTracker(private val now: () -> Long = System::currentTimeMillis) {
+    private val pending = mutableMapOf<String, Long>()
+
+    @Synchronized fun expect(id: String) {
+        pending.entries.removeAll { it.value <= now() }
+        pending[id] = now() + 90000
+    }
+
+    @Synchronized fun forget(id: String) { pending.remove(id) }
+
+    @Synchronized fun consume(id: String): Boolean = (pending.remove(id) ?: 0) > now()
+}
+
+object VoiceReplies { val pending = VoiceReplyTracker() }
