+++ b/app/src/main/java/com/example/assistentecell/network/BackendAuthInterceptor.kt
@@ -0,0 +1,24 @@
+package com.example.assistentecell.network
+
+import java.io.IOException
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import okhttp3.Interceptor
+import okhttp3.Response
+
+class BackendAuthInterceptor(
+    private val serverUrl: () -> String,
+    private val savedToken: () -> String
+) : Interceptor {
+    override fun intercept(chain: Interceptor.Chain): Response {
+        val request = chain.request()
+        val server = serverUrl().toHttpUrlOrNull()
+        val sameServer = server != null && request.url.host == server.host &&
+            request.url.port == server.port && request.url.isHttps == server.isHttps
+        if (!sameServer) return chain.proceed(request)
+        val raw = savedToken()
+        if (raw.isBlank()) return chain.proceed(request)
+        val token = BackendSettings.normalizeToken(raw)
+            ?: throw IOException("Token de acesso inválido. Corrija o campo nas configurações do servidor.")
+        return chain.proceed(request.newBuilder().header("Authorization", "Bearer $token").build())
+    }
+}
