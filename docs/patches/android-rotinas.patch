+package com.example.assistentecell
+
+import com.example.assistentecell.network.BackendAuthInterceptor
+import com.example.assistentecell.network.BackendSettings
+import java.io.IOException
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicReference
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.OkHttpClient
+import okhttp3.Protocol
+import okhttp3.Request
+import okhttp3.Response
+import okhttp3.ResponseBody.Companion.toResponseBody
+import org.junit.Assert.*
+import org.junit.Test
+
+class BackendAuthTest {
+    @Test fun copiedEnvLineAndBearerPrefixAreNormalized() {
+        assertEquals("example-token", BackendSettings.normalizeToken(" \r\nOLLIE_API_TOKEN=\r\n\"example-token\"\r\n"))
+        assertEquals("example-token", BackendSettings.normalizeToken("Bearer example-token"))
+        assertEquals("example-token", BackendSettings.normalizeToken("'example-token'"))
+    }
+
+    @Test fun malformedTokensAreRejectedBeforeHeaderConstruction() {
+        for (raw in listOf("", " ", "OLLIE_API_TOKEN\nexample", "abc\ndef", "abc\rdef", "abc\tdef", "abc def", "abc\u0000def", "abc\u007fdef", "abc🔑")) {
+            assertNull(BackendSettings.normalizeToken(raw))
+        }
+    }
+
+    @Test fun serverUrlIsValidatedBeforeSaving() {
+        assertEquals("https://example.test/", BackendSettings.normalizeBaseUrl(" example.test "))
+        assertEquals("http://localhost:8000/api/", BackendSettings.normalizeBaseUrl("http://localhost:8000/api"))
+        for (url in listOf("", "https://bad host/", "ftp://example.test", "https://user:pass@example.test/", "https://example.test/?token=oops")) {
+            assertNull(BackendSettings.normalizeBaseUrl(url))
+        }
+    }
+
+    private fun client(server: String, token: () -> String, received: AtomicReference<Request>): OkHttpClient =
+        OkHttpClient.Builder().addInterceptor(BackendAuthInterceptor({ server }, token))
+            .addInterceptor { chain ->
+                received.set(chain.request())
+                Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1)
+                    .code(200).message("OK").body("ok".toResponseBody()).build()
+            }.build()
+
+    @Test fun exactCrashInputUsesFailureCallbackAndDispatcherRemainsUsable() {
+        var token = "OLLIE_API_TOKEN\nnot-a-real-secret"
+        val received = AtomicReference<Request>()
+        val client = client("https://example.test/", { token }, received)
+        try {
+            val request = Request.Builder().url("https://example.test/eventos").build()
+            val failed = CountDownLatch(1)
+            val error = AtomicReference<IOException>()
+            client.newCall(request).enqueue(object : Callback {
+                override fun onFailure(call: Call, e: IOException) { error.set(e); failed.countDown() }
+                override fun onResponse(call: Call, response: Response) { response.close(); failed.countDown() }
+            })
+            assertTrue(failed.await(3, TimeUnit.SECONDS))
+            assertTrue(error.get()?.message?.contains("Token de acesso inválido") == true)
+            assertFalse(error.get()?.message?.contains(token) == true)
+            assertNull(received.get()) // Invalid credentials never reach the next interceptor/network.
+            token = "OLLIE_API_TOKEN=example-token"
+            client.newCall(request).execute().use { assertEquals(200, it.code) }
+            assertEquals("Bearer example-token", received.get().header("Authorization"))
+        } finally {
+            client.dispatcher.executorService.shutdownNow()
+            client.connectionPool.evictAll()
+        }
+    }
+
+    @Test fun tokenIsNotReadOrSentToAnotherServer() {
+        val received = AtomicReference<Request>()
+        val client = client("https://example.test/", { error("Credential provider must not be called") }, received)
+        try {
+            client.newCall(Request.Builder().url("https://homeassistant.test/api").build()).execute().close()
+            assertNull(received.get().header("Authorization"))
+        } finally { client.dispatcher.executorService.shutdownNow() }
+    }
+
+    @Test fun emptySavedTokenDoesNotCrashRequests() {
+        val received = AtomicReference<Request>()
+        val client = client("https://example.test/", { "" }, received)
+        try {
+            client.newCall(Request.Builder().url("https://example.test/").build()).execute().close()
+            assertNull(received.get().header("Authorization"))
+        } finally { client.dispatcher.executorService.shutdownNow() }
+    }
+}
