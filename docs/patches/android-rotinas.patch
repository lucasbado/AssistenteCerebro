@@ -0,0 +1,33 @@
+package com.example.assistentecell.notifications
+
+/** Correlation identifies a conversation; event ID identifies one delivery. */
+class IncomingMessagePolicy {
+    private val received = mutableMapOf<String, Long>()
+
+    @Synchronized
+    fun isDuplicate(type: String, eventId: String, correlationId: String,
+                    text: String, action: String, parameter: String, now: Long): Boolean {
+        received.entries.removeAll { now - it.value >= 3_600_000L }
+        if (type !in setOf("NOTIFICACAO", "CHAT_RESPONSE", "EVENTO_LOG", "COMANDO_SISTEMA", "COMANDO_PC")) return false
+        val identity = if (eventId.isNotBlank()) eventId else {
+            // Never merge responses just because numbers or accents differ.
+            if (correlationId.isBlank()) return false
+            "$correlationId|$text|$action|$parameter"
+        }
+        return received.putIfAbsent("$type|$identity", now) != null
+    }
+
+    companion object {
+        fun hideHabitMessage(type: String, title: String, text: String,
+                             hasAction: Boolean, filterEnabled: Boolean): Boolean {
+            if (type != "NOTIFICACAO" || hasAction || !filterEnabled) return false
+            val content = "$title $text".lowercase()
+            // Only legacy decorative messages; actionable routines remain visible.
+            return listOf("bom te ver por aqui", "boa escolha!", "ótima escolha!", "um dos seus apps mais usados")
+                .any { content.contains(it) }
+        }
+
+        fun showSystemNotification(type: String, appInForeground: Boolean): Boolean =
+            type == "NOTIFICACAO" || (type == "CHAT_RESPONSE" && !appInForeground)
+    }
+}
