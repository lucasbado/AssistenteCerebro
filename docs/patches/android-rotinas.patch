@@ -0,0 +1,54 @@
+package com.example.assistentecell.data
+
+import com.example.assistentecell.data.api.HomeAssistantApiService
+import com.example.assistentecell.data.model.HAEntity
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withTimeout
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import java.io.IOException
+import java.util.concurrent.ConcurrentHashMap
+
+/** Estado e ação confirmados, compartilhados pelo botão e pela ponte da Ollie. */
+class HomeAssistantLightController(private val api: HomeAssistantApiService) {
+    companion object { private val locks = ConcurrentHashMap<String, Mutex>() }
+
+    suspend fun execute(token: String, action: String, entityId: String,
+                        attributes: Map<String, Any> = emptyMap()): HAEntity {
+        require(entityId.matches(Regex("light\\.[a-z0-9_]+"))) { "Entidade de luz inválida." }
+        require(action in setOf("ligar", "desligar", "alternar", "consultar")) { "Ação de luz inválida." }
+        if (token.isBlank()) throw IOException("Configure o acesso ao Home Assistant.")
+        return locks.getOrPut(entityId) { Mutex() }.withLock {
+            withTimeout(12000) {
+                suspend fun read(): HAEntity {
+                    val response = api.getEntityState("Bearer $token", entityId)
+                    if (!response.isSuccessful) throw IOException("Não consegui consultar essa luz (HTTP ${response.code()}).")
+                    val light = response.body() ?: throw IOException("O Home Assistant não informou a luz.")
+                    if (light.entityId != entityId) throw IOException("O Home Assistant respondeu por outra luz.")
+                    if (light.state !in setOf("on", "off")) throw IOException("Essa luz está indisponível no Home Assistant.")
+                    return light
+                }
+                var current = read()
+                val expected = when (action) {
+                    "ligar" -> "on"
+                    "desligar" -> "off"
+                    "alternar" -> if (current.state == "on") "off" else "on"
+                    else -> current.state
+                }
+                if (action != "consultar" && (current.state != expected || attributes.isNotEmpty())) {
+                    val response = api.callService("Bearer $token", "light",
+                        if (expected == "on") "turn_on" else "turn_off",
+                        attributes + mapOf("entity_id" to entityId))
+                    if (!response.isSuccessful) throw IOException("Não consegui controlar a luz (HTTP ${response.code()}).")
+                    repeat(5) {
+                        current = read()
+                        if (current.state == expected) return@withTimeout current
+                        delay(300)
+                    }
+                    throw IOException("O Home Assistant aceitou o pedido, mas a luz não confirmou a mudança.")
+                }
+                current
+            }
+        }
+    }
+}
