@@ -0,0 +1,25 @@
+package com.example.assistentecell.data
+
+import com.example.assistentecell.data.model.HAEntity
+import java.text.Normalizer
+import java.util.Locale
+
+/** Resolve apenas entre dispositivos recebidos do HA; nunca inventa entity_id. */
+object HouseLightResolver {
+    fun resolve(query: String, entities: List<HAEntity>): HAEntity {
+        val lights = entities.filter { it.entityId.startsWith("light.") }
+        val exact = lights.singleOrNull { it.entityId == query }
+        if (exact != null) return exact
+        if (query.startsWith("light.")) throw IllegalArgumentException("Essa luz não existe no Home Assistant.")
+        fun words(value: String): Set<String> = Normalizer.normalize(value.lowercase(Locale.ROOT), Normalizer.Form.NFD)
+            .replace(Regex("\\p{M}+"), "").split(Regex("[^a-z0-9]+"))
+            .filter { it.isNotBlank() && it !in setOf("luz", "luzes", "light", "lampada", "lampadas", "do", "da", "de", "a", "as") }.toSet()
+        val requested = words(query)
+        if (requested.isEmpty()) throw IllegalArgumentException("Informe qual luz você quer controlar.")
+        val matches = lights.filter { light ->
+            requested.all { it in words(light.attributes["friendly_name"] as? String ?: "") }
+        }
+        if (matches.size != 1) throw IllegalArgumentException("Não encontrei uma única luz com esse nome. Escolha a luz na tela inicial.")
+        return matches.single()
+    }
+}
