--- a/app/src/test/java/com/example/assistentecell/IncomingMessagePolicyTest.kt
+++ b/app/src/test/java/com/example/assistentecell/IncomingMessagePolicyTest.kt
@@ -0,0 +1,47 @@
+package com.example.assistentecell
+
+import com.example.assistentecell.notifications.IncomingMessagePolicy
+import com.example.assistentecell.sensors.ForegroundUsageTracker
+import org.junit.Assert.*
+import org.junit.Test
+
+class IncomingMessagePolicyTest {
+    @Test fun correlationDoesNotSuppressDifferentEventsOrChannels() {
+        val policy = IncomingMessagePolicy()
+        assertFalse(policy.isDuplicate("EVENTO_LOG", "log", "conversation", "", "", "", 1000))
+        assertFalse(policy.isDuplicate("NOTIFICACAO", "notification", "conversation", "Abrir?", "", "", 1001))
+        assertTrue(policy.isDuplicate("NOTIFICACAO", "notification", "conversation", "Abrir?", "", "", 1002))
+        assertFalse(policy.isDuplicate("NOTIFICACAO", "another", "conversation", "Abrir?", "", "", 1003))
+    }
+
+    @Test fun fallbackPreservesNumbersAndAccents() {
+        val policy = IncomingMessagePolicy()
+        assertFalse(policy.isDuplicate("CHAT_RESPONSE", "", "same", "Alarme às 10:30", "", "", 1000))
+        assertFalse(policy.isDuplicate("CHAT_RESPONSE", "", "same", "Alarme às 11:30", "", "", 1001))
+        assertFalse(policy.isDuplicate("CHAT_RESPONSE", "", "same", "Avó", "", "", 1002))
+        assertFalse(policy.isDuplicate("CHAT_RESPONSE", "", "same", "Avô", "", "", 1003))
+    }
+
+    @Test fun actionableHabitAndChatRemainVisible() {
+        assertFalse(IncomingMessagePolicy.hideHabitMessage("NOTIFICACAO", "Hábito", "Você costuma abrir Agenda", true, true))
+        assertFalse(IncomingMessagePolicy.hideHabitMessage("CHAT_RESPONSE", "", "Ótima escolha!", false, true))
+        assertTrue(IncomingMessagePolicy.hideHabitMessage("NOTIFICACAO", "", "Boa escolha!", false, true))
+        assertTrue(IncomingMessagePolicy.showSystemNotification("NOTIFICACAO", true))
+        assertFalse(IncomingMessagePolicy.showSystemNotification("CHAT_RESPONSE", true))
+    }
+
+    @Test fun reopeningAfterLauncherAndQuickTransitionsAreNotLost() {
+        val tracker = ForegroundUsageTracker()
+        assertTrue(tracker.resumed("com.a", 1000))
+        assertFalse(tracker.resumed("com.a", 1100))
+        tracker.paused("com.a", 1110)
+        assertFalse(tracker.resumed("com.a", 1120)) // Activity navigation within one app.
+        assertTrue(tracker.resumed("launcher", 1200))
+        assertTrue(tracker.resumed("com.a", 1300))
+        assertTrue(tracker.resumed("com.b", 1400))
+        assertFalse(tracker.resumed("com.old", 1000))
+        assertEquals("com.b", tracker.heartbeat(61_500))
+        tracker.paused("com.b", 62_000)
+        assertNull(tracker.heartbeat(125_000))
+    }
+}
--- a/app/src/test/java/com/example/assistentecell/RoutineManagementTest.kt
+++ b/app/src/test/java/com/example/assistentecell/RoutineManagementTest.kt
@@ -0,0 +1,105 @@
+package com.example.assistentecell
+
+import com.example.assistentecell.data.api.CognitiveApiService
+import com.example.assistentecell.data.model.*
+import com.example.assistentecell.data.repository.CognitiveRepository
+import com.example.assistentecell.automation.RoutineDescription
+import com.example.assistentecell.network.BackendAuthInterceptor
+import com.google.gson.Gson
+import com.google.gson.JsonObject
+import kotlinx.coroutines.runBlocking
+import okhttp3.*
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.ResponseBody.Companion.toResponseBody
+import okio.Buffer
+import org.junit.Assert.*
+import org.junit.Test
+import retrofit2.Retrofit
+import retrofit2.converter.gson.GsonConverterFactory
+
+class RoutineManagementTest {
+    private fun client(block: (Request) -> Pair<Int, String>): Pair<OkHttpClient, CognitiveRepository> {
+        val client = OkHttpClient.Builder()
+            .addInterceptor(BackendAuthInterceptor({ "https://example.test/" }, { "test-token" }))
+            .addInterceptor { chain ->
+                val result = block(chain.request())
+                Response.Builder().request(chain.request()).protocol(Protocol.HTTP_1_1).code(result.first)
+                    .message("Test").body(result.second.toResponseBody("application/json".toMediaType())).build()
+            }.build()
+        val api = Retrofit.Builder().baseUrl("https://example.test/").client(client)
+            .addConverterFactory(GsonConverterFactory.create()).build().create(CognitiveApiService::class.java)
+        return client to CognitiveRepository(api)
+    }
+
+    @Test fun actualStoredRoutineHasTriggerAndEveryAction() {
+        val old = """{"nome":"Editor","gatilho":{"tipo":"APP_OPENED","pacote":"com.trabalho"},"acoes":[{"alvo":"PC","comando":"abrir_app","parametro":"code.exe"},{"alvo":"IA","comando":"NOTIFICAR","parametro":"Agenda?"}],"ativa":false}"""
+        val routine = Gson().fromJson(old, ApiRoutine::class.java)
+        assertEquals(2, routine.acoes.size)
+        assertEquals("Ao abrir Trabalho no celular", RoutineDescription.trigger(routine) { "Trabalho" })
+        assertEquals("Abrir code.exe no PC", RoutineDescription.action(routine.acoes[0]))
+        assertFalse(routine.ativa)
+        assertNull(routine.pode_ativar) // An old server must not imply validation.
+    }
+
+    @Test fun unicodeAndSlashNamesStayInBodiesAndUseAuthentication() = runBlocking {
+        val requests = mutableListOf<Request>()
+        val (client, repo) = client { requests.add(it); 200 to """{"status":"success","message":"OK"}""" }
+        try {
+            val name = "Rotina / desenho → editor"
+            assertTrue(repo.approveRoutine(name).isSuccess)
+            assertTrue(repo.rejectRoutine(name).isSuccess)
+            assertEquals(listOf("POST", "DELETE"), requests.map { it.method })
+            assertEquals(listOf("/api/v1/capabilities/approve", "/api/v1/capabilities/discovered"), requests.map { it.url.encodedPath })
+            requests.forEach {
+                assertEquals("Bearer test-token", it.header("Authorization"))
+                val body = Buffer(); it.body!!.writeTo(body)
+                assertEquals(name, Gson().fromJson(body.readUtf8(), JsonObject::class.java)["nome"].asString)
+            }
+        } finally { client.dispatcher.executorService.shutdownNow() }
+    }
+
+    @Test fun pausedRoutineIsLoadedWithoutSendingAnyMutation() = runBlocking {
+        val requests = mutableListOf<Request>()
+        val (client, repo) = client {
+            requests.add(it)
+            200 to """[{"nome":"Pausa","ativa":false,"pode_ativar":true,"gatilho":{"tipo":"APP_OPENED","pacote":"com.a"},"acoes":[]}]"""
+        }
+        try {
+            assertFalse(repo.getRoutines().getOrThrow().single().ativa)
+            repo.getDiscoveredRoutines().getOrThrow()
+            assertTrue(requests.all { it.method == "GET" })
+        } finally { client.dispatcher.executorService.shutdownNow() }
+    }
+
+    @Test fun validationAndOldServerErrorsReachTheScreen() = runBlocking {
+        var code = 422
+        val (client, repo) = client { code to """{"detail":"Esse gatilho não produz eventos."}""" }
+        try {
+            assertTrue(repo.approveRoutine("Inválida").exceptionOrNull()!!.message!!.contains("gatilho"))
+            code = 405
+            assertTrue(repo.setRoutineState("Pausa", false).exceptionOrNull()!!.message!!.contains("atualização"))
+        } finally { client.dispatcher.executorService.shutdownNow() }
+    }
+
+    @Test fun deleteCanUseThePublishedLegacyEndpoint() = runBlocking {
+        val requests = mutableListOf<Request>()
+        val (client, repo) = client {
+            requests.add(it)
+            if (it.url.encodedPath.endsWith("/routines")) 405 to "{}"
+            else 200 to """{"status":"success","message":"Removed"}"""
+        }
+        try {
+            assertTrue(repo.deleteRoutine("Editor").isSuccess)
+            assertEquals("/api/v1/capabilities/routines/Editor", requests.last().url.encodedPath)
+            assertTrue(requests.all { it.method == "DELETE" })
+        } finally { client.dispatcher.executorService.shutdownNow() }
+    }
+
+    @Test fun localDraftMigrationIsPausedAndKeepsTriggerAndAction() {
+        val rule = AutomationRule("old", "Editor", "automacao", "com.trabalho", "PC_COMMAND", "vscode")
+        val draft = RoutineDescription.fromLegacy(rule)
+        assertFalse(draft.ativa)
+        assertEquals("com.trabalho", draft.gatilho!!.pacote)
+        assertEquals(RoutineAction("PC", "abrir_app", "vscode"), draft.acoes.single())
+    }
+}
--- a/app/src/test/java/com/example/assistentecell/VoiceReplyTrackerTest.kt
+++ b/app/src/test/java/com/example/assistentecell/VoiceReplyTrackerTest.kt
@@ -0,0 +1,35 @@
+package com.example.assistentecell
+
+import com.example.assistentecell.voice.VoiceReplyTracker
+import org.junit.Assert.*
+import org.junit.Test
+
+class VoiceReplyTrackerTest {
+    @Test fun unrelatedNotificationDoesNotConsumeSpokenReply() {
+        val replies = VoiceReplyTracker { 1000L }
+        replies.expect("voice-1")
+        assertFalse(replies.consume("notification-1"))
+        assertFalse(replies.consume(""))
+        assertTrue(replies.consume("voice-1"))
+        assertFalse(replies.consume("voice-1"))
+    }
+
+    @Test fun oldOrRejectedRequestsDoNotSpeakLater() {
+        var time = 1000L
+        val replies = VoiceReplyTracker { time }
+        replies.expect("old")
+        replies.expect("rejected")
+        replies.forget("rejected")
+        assertFalse(replies.consume("rejected"))
+        time += 90001
+        assertFalse(replies.consume("old"))
+    }
+
+    @Test fun multipleVoiceRequestsKeepTheirOwnReply() {
+        val replies = VoiceReplyTracker { 1000L }
+        replies.expect("first")
+        replies.expect("second")
+        assertTrue(replies.consume("second"))
+        assertTrue(replies.consume("first"))
+    }
+}
