@@ -0,0 +1,27 @@
+package com.example.assistentecell.network
+
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+
+/** Shared by the settings form and transport, including preferences saved by older builds. */
+object BackendSettings {
+    fun normalizeToken(raw: String): String? {
+        var token = raw.trim().removePrefix("\uFEFF").trim()
+        token = token.replaceFirst(Regex("^OLLIE_API_TOKEN\\s*=\\s*", RegexOption.IGNORE_CASE), "").trim()
+        token = token.replaceFirst(Regex("^Bearer\\s+", RegexOption.IGNORE_CASE), "").trim()
+        if (token.length >= 2 && ((token.first() == '"' && token.last() == '"') ||
+                (token.first() == '\'' && token.last() == '\''))) {
+            token = token.substring(1, token.length - 1)
+        }
+        // Reject embedded whitespace/control/non-ASCII characters before Headers.Builder sees them.
+        return token.takeIf { it.isNotEmpty() && it.all { char -> char.code in 33..126 } }
+    }
+
+    fun normalizeBaseUrl(raw: String): String? {
+        val trimmed = raw.trim()
+        if (trimmed.isEmpty() || trimmed.any { it.isWhitespace() || it.isISOControl() }) return null
+        val candidate = if (trimmed.contains("://")) trimmed else "https://$trimmed"
+        val url = candidate.toHttpUrlOrNull() ?: return null
+        if (url.username.isNotEmpty() || url.password.isNotEmpty() || url.query != null || url.fragment != null) return null
+        return if (url.encodedPath.endsWith("/")) url.toString() else url.newBuilder().addPathSegment("").build().toString()
+    }
+}
