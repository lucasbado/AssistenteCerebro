@@ -0,0 +1,15 @@
+package com.example.assistentecell.network
+
+import com.google.gson.Gson
+import com.google.gson.JsonObject
+
+object RoutineErrors {
+    fun message(code: Int, body: String?): String {
+        if (code == 401 || code == 403) return "O servidor recusou o token. Confira a conexão nas configurações."
+        if (code == 405) return "O servidor ainda precisa da atualização de gerenciamento de rotinas."
+        val detail = runCatching {
+            Gson().fromJson(body, JsonObject::class.java)?.get("detail")?.takeIf { it.isJsonPrimitive }?.asString
+        }.getOrNull()
+        return detail?.takeIf { it.isNotBlank() } ?: "Não consegui concluir a ação nas rotinas (HTTP $code)."
+    }
+}
