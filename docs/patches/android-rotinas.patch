+
+    override fun onResume() {
+        super.onResume()
+        if (!handled) {
+            handled = true
+            val correlation = intent.getStringExtra("correlacao_id").orEmpty()
+            val notification = intent.getStringExtra("notificacao_id")
+            SystemCommandHandler.executeCommand(this, intent.getStringExtra("acao_tipo"),
+                intent.getStringExtra("acao_parametro"), userInitiated = true)
+            if (correlation.isNotBlank()) {
+                SuggestionFeedback.send(this, correlation, "ACTION_CLICKED", notification)
+                NotificationManagerCompat.from(this).cancel((notification ?: correlation).hashCode())
+            }
+        }
+        finish()
+    }
+}
--- a/app/src/main/java/com/example/assistentecell/notifications/SuggestionFeedback.kt
+++ b/app/src/main/java/com/example/assistentecell/notifications/SuggestionFeedback.kt
@@ -0,0 +1,40 @@
+package com.example.assistentecell.notifications
+
+import android.content.Context
+import android.util.Log
+import com.example.assistentecell.ListenerDeNotificacoes
+import com.example.assistentecell.api.RetrofitClient
+import okhttp3.Call
+import okhttp3.Callback
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import okhttp3.Response
+import org.json.JSONObject
+import java.io.IOException
+
+object SuggestionFeedback {
+    fun send(context: Context, correlationId: String, type: String, notificationId: String? = null,
+             onComplete: () -> Unit = {}) {
+        RetrofitClient.init(context)
+        val payload = JSONObject().put("correlacao_id", correlationId).put("tipo_feedback", type)
+        notificationId?.let { payload.put("notificacao_id", it) }
+        val message = JSONObject(payload.toString()).put("tipo_ws", "FEEDBACK")
+        if (ListenerDeNotificacoes.enviarMensagemWebSocket(message.toString())) {
+            onComplete()
+            return
+        }
+        val request = Request.Builder().url(RetrofitClient.getBaseUrl() + "feedback/")
+            .post(payload.toString().toRequestBody("application/json".toMediaType())).build()
+        RetrofitClient.backendHttpClient.newCall(request).enqueue(object : Callback {
+            override fun onFailure(call: Call, e: IOException) {
+                Log.w("SuggestionFeedback", "Feedback não entregue: ${e.message}")
+                onComplete()
+            }
+            override fun onResponse(call: Call, response: Response) {
+                response.use { if (!it.isSuccessful) Log.w("SuggestionFeedback", "Feedback recusado: HTTP ${it.code}") }
+                onComplete()
+            }
+        })
+    }
+}
--- a/app/src/main/java/com/example/assistentecell/sensors/ForegroundUsageTracker.kt
+++ b/app/src/main/java/com/example/assistentecell/sensors/ForegroundUsageTracker.kt
@@ -0,0 +1,32 @@
+package com.example.assistentecell.sensors
+
+/** Keeps excluded apps as boundaries, so A -> launcher -> A is a new opening. */
+class ForegroundUsageTracker {
+    var currentPackage: String = ""
+        private set
+    private var lastTimestamp = 0L
+    private var lastHeartbeat = 0L
+    private var pausedAt: Long? = null
+
+    fun resumed(packageName: String, timestamp: Long): Boolean {
+        if (timestamp < lastTimestamp) return false
+        lastTimestamp = timestamp
+        val changed = packageName != currentPackage || pausedAt?.let { timestamp - it > 2000L } == true
+        currentPackage = packageName
+        pausedAt = null
+        if (changed) lastHeartbeat = timestamp
+        return changed
+    }
+
+    fun paused(packageName: String, timestamp: Long) {
+        if (timestamp < lastTimestamp) return
+        lastTimestamp = timestamp
+        if (currentPackage == packageName) pausedAt = timestamp
+    }
+
+    fun heartbeat(now: Long): String? {
+        if (currentPackage.isBlank() || pausedAt != null || now - lastHeartbeat < 60_000L) return null
+        lastHeartbeat = now
+        return currentPackage
+    }
+}
