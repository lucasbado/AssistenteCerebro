+package com.example.assistentecell.network
+
+import com.google.gson.Gson
+import com.google.gson.JsonObject
+
+data class HouseCommand(val id: String, val action: String, val entityId: String) {
+    companion object {
+        fun parse(raw: String): HouseCommand {
+            val json = Gson().fromJson(raw, JsonObject::class.java)
+            val id = json.get("id_comando")?.asString.orEmpty()
+            val action = json.get("acao")?.asString.orEmpty()
+            val entity = json.get("entity_id")?.asString.orEmpty()
+            require(id.matches(Regex("[\\w.:-]{1,128}"))) { "ID inválido" }
+            require(action in setOf("ligar", "desligar", "alternar", "consultar")) { "Ação inválida" }
+            require(entity.matches(Regex("light\\.[a-z0-9_]+"))) { "Entidade inválida" }
+            return HouseCommand(id, action, entity)
+        }
+    }
+}
