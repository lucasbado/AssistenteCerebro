+package com.example.assistentecell
+
+import com.example.assistentecell.ui.theme.AssistenteCellTheme
+import androidx.test.platform.app.InstrumentationRegistry
+import android.graphics.Bitmap
+import java.io.File
+import androidx.compose.runtime.*
+import androidx.compose.ui.test.*
+import androidx.compose.ui.test.junit4.createAndroidComposeRule
+import androidx.activity.compose.setContent
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import com.example.assistentecell.ui.components.VoicePickerDialog
+import com.example.assistentecell.voice.*
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class VoicePickerTest {
+    @get:Rule val compose = createAndroidComposeRule<MainActivity>()
+
+    @Test fun previewUsesTappedVoiceWithoutChangingSelectionAndCanStop() {
+        var selected = VoiceCatalog.DEFAULT_ID
+        var requested: String? = null
+        var stopped = false
+        compose.activityRule.scenario.onActivity { activity ->
+          activity.setContent {
+            var preview by remember { mutableStateOf(VoicePreviewState()) }
+            AssistenteCellTheme(darkTheme = true, dynamicColor = false) {
+                VoicePickerDialog(VoiceCatalog.natural, selected, preview, { selected = it }, {
+                    requested = it; preview = VoicePreviewState(it, PreviewPhase.PREPARING, "Preparando a amostra…")
+                }, { stopped = true; preview = VoicePreviewState() }, {})
+            }
+        }
+        }
+        val francisca = "cloud:pt-BR-FranciscaNeural"
+        compose.onNodeWithTag("voice-preview-$francisca").performClick()
+        compose.runOnIdle { assertEquals(francisca, requested); assertEquals(VoiceCatalog.DEFAULT_ID, selected) }
+        compose.onNodeWithText("Preparando a amostra…").assertIsDisplayed()
+        compose.onNodeWithTag("voice-preview-$francisca").performClick()
+        compose.runOnIdle { assertTrue(stopped) }
+        val image = InstrumentationRegistry.getInstrumentation().uiAutomation.takeScreenshot()
+        File(InstrumentationRegistry.getInstrumentation().targetContext.cacheDir, "voice-picker.png").outputStream().use {
+            image.compress(Bitmap.CompressFormat.PNG, 100, it)
+        }
+        image.recycle()
+    }
+}
