@@ -0,0 +1,73 @@
+package com.example.assistentecell
+
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.example.assistentecell.api.RetrofitClient
+import com.example.assistentecell.voice.*
+import android.os.SystemClock
+import org.junit.Assert.*
+import org.junit.Assume.assumeNotNull
+import org.junit.Test
+import org.junit.runner.RunWith
+
+@RunWith(AndroidJUnit4::class)
+class VoicePlaybackTest {
+    private val instrumentation get() = InstrumentationRegistry.getInstrumentation()
+
+    private fun manager(): VoiceManager {
+        lateinit var result: VoiceManager
+        instrumentation.runOnMainSync {
+            RetrofitClient.init(instrumentation.targetContext)
+            result = VoiceManager(instrumentation.targetContext)
+        }
+        return result
+    }
+
+    private fun checkPlayback(manager: VoiceManager, id: String) {
+        val prefs = instrumentation.targetContext.getSharedPreferences("sistema_prefs", 0)
+        val before = prefs.getString("selected_voice", "")
+        instrumentation.runOnMainSync { manager.previewVoice(id) }
+        var heard = false
+        val deadline = SystemClock.elapsedRealtime() + 32000
+        var state: VoicePreviewState
+        do {
+            state = manager.previewState.value
+            heard = heard || state.phase == PreviewPhase.PLAYING
+            if(state.phase in listOf(PreviewPhase.DONE, PreviewPhase.ERROR)) break
+            SystemClock.sleep(25)
+        } while(SystemClock.elapsedRealtime() < deadline)
+        assertEquals("Amostra não concluída: ${state.message}", PreviewPhase.DONE, state.phase)
+        assertTrue("Não houve início de reprodução", heard)
+        assertEquals(id, state.voiceId)
+        assertEquals("Ouvir não pode salvar outra voz", before, prefs.getString("selected_voice", ""))
+    }
+
+    @Test fun namedCloudPreviewPlaysWithoutChangingSavedVoice() {
+        val manager = manager()
+        try { checkPlayback(manager, "cloud:pt-BR-FranciscaNeural") }
+        finally { instrumentation.runOnMainSync { manager.shutdown() } }
+    }
+
+    @Test fun installedLocalVoicePlaysThroughLocalEngine() {
+        val manager = manager()
+        try {
+            val deadline = SystemClock.elapsedRealtime() + 6000
+            while(manager.availableVoices.value.none { it.localName != null } && SystemClock.elapsedRealtime() < deadline) SystemClock.sleep(50)
+            val voice = manager.availableVoices.value.firstOrNull { it.localName != null && it.description.contains("sem internet") }
+            assumeNotNull(voice)
+            checkPlayback(manager, voice!!.id)
+        } finally { instrumentation.runOnMainSync { manager.shutdown() } }
+    }
+
+    @Test fun stoppingPreviewPreventsLatePlayback() {
+        val manager = manager()
+        try {
+            instrumentation.runOnMainSync {
+                manager.previewVoice("cloud:pt-BR-AntonioNeural")
+                manager.stopPreview()
+            }
+            SystemClock.sleep(1200)
+            assertEquals(PreviewPhase.IDLE, manager.previewState.value.phase)
+        } finally { instrumentation.runOnMainSync { manager.shutdown() } }
+    }
+}
