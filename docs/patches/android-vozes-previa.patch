+package com.example.assistentecell
+
+import com.example.assistentecell.voice.*
+import org.junit.Assert.*
+import org.junit.Test
+
+class VoiceCatalogTest {
+    @Test fun namesAreReadableAndIdentifiersRemainStable() {
+        val local = listOf(LocalVoiceInfo("pt-pt-x-abc-network", "PT", true), LocalVoiceInfo("pt-br-x-xyz-local", "BR", false))
+        val options = VoiceCatalog.options(local)
+        assertEquals(options, VoiceCatalog.options(local.reversed()))
+        assertEquals(listOf("Thalita", "Francisca", "Antônio"), options.take(3).map { it.label })
+        assertEquals("Voz do celular 1", options[3].label)
+        assertEquals("pt-br-x-xyz-local", options[3].id)
+        assertTrue(options[3].description.contains("sem internet"))
+        assertTrue(options[4].description.contains("Portugal"))
+        assertEquals("pt-br-x-xyz-local", VoiceCatalog.selectedId("pt-br-x-xyz-local"))
+    }
+
+    @Test fun defaultAndLegacyCloudNamesResolveToActualCatalog() {
+        assertEquals(VoiceCatalog.DEFAULT_ID, VoiceCatalog.selectedId(""))
+        assertEquals(VoiceCatalog.DEFAULT_ID, VoiceCatalog.selectedId("pt-BR-ThalitaNeural"))
+        assertEquals("cloud:pt-BR-FranciscaNeural", VoiceCatalog.selectedId("pt-BR-FranciscaNeural"))
+        assertEquals(3, VoiceCatalog.options(emptyList()).size)
+    }
+}
