+package com.example.assistentecell.ui.components
+
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.outlined.PlayArrow
+import androidx.compose.material.icons.outlined.Stop
+import androidx.compose.material3.*
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.platform.testTag
+import androidx.compose.ui.unit.dp
+import com.example.assistentecell.voice.*
+
+@Composable
+fun VoicePickerDialog(voices: List<OllieVoice>, selected: String, preview: VoicePreviewState,
+    onSelect: (String) -> Unit, onPreview: (String) -> Unit, onStop: () -> Unit, onDismiss: () -> Unit) {
+    AlertDialog(onDismissRequest = onDismiss, title = { Text("Escolha a voz da Ollie") }, text = {
+        Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+            Text("Toque em Ouvir para comparar. A amostra usa o volume de mídia e não muda sua escolha.")
+            if(voices.none { it.id == selected }) Text("A voz salva não está disponível. Escolha outra opção.", color = MaterialTheme.colorScheme.error)
+            LazyColumn(Modifier.heightIn(max = 390.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                for((natural, title) in listOf(true to "Vozes naturais", false to "Vozes do celular")) {
+                    val group = voices.filter { (it.cloudName != null) == natural }
+                    item { Text(title, style = MaterialTheme.typography.titleSmall) }
+                    if(group.isEmpty()) item { Text("As vozes do celular ainda não estão disponíveis. Confira os dados de voz nas configurações do Android.") }
+                    items(group, key = { it.id }) { voice ->
+                        val chosen = voice.id == selected
+                        val active = preview.voiceId == voice.id && preview.phase in listOf(PreviewPhase.PREPARING, PreviewPhase.PLAYING)
+                        Surface(onClick = { onSelect(voice.id) }, modifier = Modifier.fillMaxWidth().testTag("voice-select-${voice.id}"),
+                            shape = RoundedCornerShape(12.dp), color = if(chosen) MaterialTheme.colorScheme.primaryContainer.copy(alpha = .5f) else Color.Transparent) {
+                            Column(Modifier.padding(10.dp)) {
+                                Row(verticalAlignment = Alignment.CenterVertically) {
+                                    RadioButton(selected = chosen, onClick = { onSelect(voice.id) })
+                                    Column(Modifier.weight(1f)) {
+                                        Text(voice.label, style = MaterialTheme.typography.titleMedium)
+                                        Text(voice.description, style = MaterialTheme.typography.bodySmall)
+                                        if(chosen) Text("Voz escolhida", style = MaterialTheme.typography.labelSmall, color = MaterialTheme.colorScheme.primary)
+                                    }
+                                    TextButton(modifier = Modifier.testTag("voice-preview-${voice.id}"), onClick = { if(active) onStop() else onPreview(voice.id) }) {
+                                        Icon(if(active) Icons.Outlined.Stop else Icons.Outlined.PlayArrow, contentDescription = null, modifier = Modifier.size(18.dp))
+                                        Text(if(active) "Parar" else "Ouvir")
+                                    }
+                                }
+                                if(preview.voiceId == voice.id && preview.message.isNotEmpty()) {
+                                    if(preview.phase == PreviewPhase.PREPARING) LinearProgressIndicator(Modifier.fillMaxWidth())
+                                    Text(preview.message, style = MaterialTheme.typography.bodySmall,
+                                        color = if(preview.phase == PreviewPhase.ERROR) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.primary)
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }, confirmButton = { TextButton(onClick = onDismiss) { Text("Pronto") } })
+}
