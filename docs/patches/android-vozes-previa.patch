@@ -0,0 +1,32 @@
+package com.example.assistentecell.voice
+
+data class LocalVoiceInfo(val name: String, val country: String, val network: Boolean)
+
+data class OllieVoice(val id: String, val label: String, val description: String,
+    val cloudName: String? = null, val localName: String? = null)
+
+enum class PreviewPhase { IDLE, PREPARING, PLAYING, DONE, ERROR }
+data class VoicePreviewState(val voiceId: String? = null, val phase: PreviewPhase = PreviewPhase.IDLE,
+    val message: String = "")
+
+object VoiceCatalog {
+    const val DEFAULT_ID = "cloud:pt-BR-ThalitaMultilingualNeural"
+    val natural = listOf(
+        OllieVoice(DEFAULT_ID, "Thalita", "Português do Brasil · feminina · precisa de internet", cloudName = "pt-BR-ThalitaMultilingualNeural"),
+        OllieVoice("cloud:pt-BR-FranciscaNeural", "Francisca", "Português do Brasil · feminina · precisa de internet", cloudName = "pt-BR-FranciscaNeural"),
+        OllieVoice("cloud:pt-BR-AntonioNeural", "Antônio", "Português do Brasil · masculina · precisa de internet", cloudName = "pt-BR-AntonioNeural")
+    )
+
+    fun selectedId(saved: String?): String = when(saved) {
+        null, "", "pt-BR-ThalitaNeural", "cloud:pt-BR-ThalitaNeural" -> DEFAULT_ID
+        else -> natural.firstOrNull { it.cloudName == saved }?.id ?: saved
+    }
+
+    fun options(local: List<LocalVoiceInfo>): List<OllieVoice> = natural +
+        local.distinctBy { it.name }.sortedWith(compareBy<LocalVoiceInfo> { it.country != "BR" }.thenBy { it.name })
+            .mapIndexed { index, voice ->
+                val region = when(voice.country) { "BR" -> "Português do Brasil"; "PT" -> "Português de Portugal"; else -> "Português" }
+                OllieVoice(voice.name, "Voz do celular ${index + 1}", region + " · " +
+                    if(voice.network) "precisa de internet" else "funciona sem internet", localName = voice.name)
+            }
+}
