@@ -0,0 +1,27 @@
+package com.example.assistentecell.tarefas
+
+import java.text.SimpleDateFormat
+import java.util.Locale
+
+data class TaskAction(val id: String, val texto: String, val quando: String)
+data class TaskItem(val id: String, val titulo: String, val prazo: String?, val quando: String,
+    val dia_inteiro: Boolean, val estado: String, val atrasada: Boolean, val origem: String,
+    val contexto: String, val versao: Int, val aviso: String)
+data class NewTask(val titulo: String, val prazo: String?, val dia_inteiro: Boolean)
+data class TaskChange(val acao: String, val versao: Int, val prazo: String? = null, val dia_inteiro: Boolean = false)
+data class TaskDeadline(val prazo: String?, val dia_inteiro: Boolean)
+
+object TaskDates {
+    fun deadline(date: String, time: String): TaskDeadline {
+        val day = date.trim(); val hour = time.trim()
+        if (day.isEmpty()) {
+            require(hour.isEmpty()) { "Escolha a data desse horário." }
+            return TaskDeadline(null, false)
+        }
+        val input = day + " " + hour.ifEmpty { "00:00" }
+        require(Regex("\\d{2}/\\d{2}/\\d{4} \\d{2}:\\d{2}").matches(input)) { "Use dd/mm/aaaa e HH:mm." }
+        val dateTime = SimpleDateFormat("dd/MM/yyyy HH:mm", Locale.ROOT).apply { isLenient = false }.parse(input)
+            ?: error("Confira a data do prazo.")
+        return TaskDeadline(SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ssXXX", Locale.ROOT).format(dateTime), hour.isEmpty())
+    }
+}
