@@ -0,0 +1,144 @@
+package com.example.assistentecell.tarefas
+
+import android.app.NotificationManager
+import android.os.Bundle
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.horizontalScroll
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.example.assistentecell.api.RetrofitClient
+import com.example.assistentecell.ui.theme.AssistenteCellTheme
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.launch
+
+class TasksActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        RetrofitClient.init(this)
+        setContent { AssistenteCellTheme(darkTheme = true, dynamicColor = false) { TasksPage() } }
+    }
+
+    @Composable
+    private fun TasksPage() {
+        val scope = rememberCoroutineScope()
+        val api = remember { RetrofitClient.cognitiveApiService }
+        var items by remember { mutableStateOf<List<TaskItem>>(emptyList()) }
+        var filter by remember { mutableStateOf("abertas") }
+        var selected by remember { mutableStateOf(intent.getStringExtra("tarefa_id")) }
+        var busy by remember { mutableStateOf(false) }
+        var error by remember { mutableStateOf<String?>(null) }
+        var notice by remember { mutableStateOf<String?>(null) }
+        var newForm by remember { mutableStateOf(false) }
+        var title by remember { mutableStateOf("") }
+        var date by remember { mutableStateOf("") }
+        var time by remember { mutableStateOf("") }
+        var postpone by remember { mutableStateOf<String?>(null) }
+        var nextDate by remember { mutableStateOf("") }
+        var nextTime by remember { mutableStateOf("") }
+
+        fun run(action: suspend () -> Unit) {
+            if (busy) return
+            busy = true; error = null; notice = null
+            scope.launch {
+                try { action() }
+                catch (e: CancellationException) { throw e }
+                catch (e: Exception) {
+                    error = if (e is retrofit2.HttpException) when(e.code()) {
+                        401 -> "Confira o servidor e o token nas configurações."
+                        404 -> "Tarefas indisponíveis. Confira a atualização do servidor."
+                        409 -> "Essa tarefa mudou. Atualize a lista antes de tentar novamente."
+                        422 -> "Confira a tarefa e o prazo. Para adiar, escolha uma data futura."
+                        else -> "Não consegui acessar suas tarefas. Tente novamente."
+                    } else e.message ?: "Não consegui concluir. Tente novamente."
+                } finally { busy = false }
+            }
+        }
+        suspend fun reload() {
+            com.example.assistentecell.calendar.CalendarMirror.enqueue(this@TasksActivity)
+            val all = api.getTasks(filter)
+            val id = selected
+            items = if (id != null && all.none { it.id == id }) listOf(api.getTask(id)) + all else all
+            items.filter { it.estado in listOf("concluida", "descartada") }.forEach {
+                getSystemService(NotificationManager::class.java).cancel(("tarefa:" + it.id).hashCode())
+            }
+        }
+        suspend fun change(item: TaskItem, action: String, deadline: TaskDeadline = TaskDeadline(null, false)) {
+            api.changeTask(item.id, TaskChange(action, item.versao, deadline.prazo, deadline.dia_inteiro))
+            if (action in listOf("concluir", "descartar", "adiar")) getSystemService(NotificationManager::class.java).cancel(("tarefa:" + item.id).hashCode())
+            postpone = null; reload()
+            notice = when(action) { "concluir" -> "Tarefa concluída."; "adiar" -> "Prazo atualizado."; "aceitar" -> "Guardado nas suas tarefas."; else -> "Tarefa descartada." }
+        }
+        LaunchedEffect(filter) { run { reload() } }
+
+        Surface(Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+            Column(Modifier.fillMaxSize().systemBarsPadding().verticalScroll(rememberScrollState()).padding(20.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                    TextButton(onClick = { finish() }) { Text("Voltar") }
+                    TextButton(enabled = !busy, onClick = { run { reload() } }) { Text("Atualizar") }
+                }
+                Text("Suas tarefas", style = MaterialTheme.typography.headlineMedium)
+                TextButton(onClick = { startActivity(android.content.Intent(this@TasksActivity, com.example.assistentecell.calendar.CalendarSettingsActivity::class.java)) }) { Text("Conectar calendário do celular") }
+                Text("Suas pendências ficam aqui até você concluir ou descartar.", color = MaterialTheme.colorScheme.onSurfaceVariant)
+                if (busy) LinearProgressIndicator(Modifier.fillMaxWidth())
+                error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+                notice?.let { Text(it, color = MaterialTheme.colorScheme.secondary) }
+                Row(Modifier.horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+                    listOf("abertas" to "Abertas", "sugestao" to "Sugestões", "concluida" to "Concluídas", "descartada" to "Descartadas").forEach { (value, label) ->
+                        FilterChip(enabled = !busy, selected = filter == value, onClick = { selected = null; filter = value }, label = { Text(label) })
+                    }
+                }
+                OutlinedButton(onClick = { newForm = !newForm }) { Text(if(newForm) "Fechar formulário" else "Nova tarefa") }
+                if (newForm) {
+                    OutlinedTextField(value = title, onValueChange = { title = it }, label = { Text("O que precisa fazer?") }, modifier = Modifier.fillMaxWidth())
+                    OutlinedTextField(value = date, onValueChange = { date = it }, label = { Text("Data do prazo — dd/mm/aaaa (opcional)") }, modifier = Modifier.fillMaxWidth())
+                    OutlinedTextField(value = time, onValueChange = { time = it }, label = { Text("Horário — HH:mm (opcional)") }, modifier = Modifier.fillMaxWidth())
+                    Text("Sem horário, a data vale até o fim do dia e não gera aviso em horário inventado. Com horário, há um aviso que depende do servidor e da conexão.", style = MaterialTheme.typography.bodySmall)
+                    Button(enabled = !busy, onClick = { run {
+                        require(title.isNotBlank()) { "Escreva o que precisa fazer." }
+                        val deadline = TaskDates.deadline(date, time)
+                        val saved = api.createTask(NewTask(title.trim(), deadline.prazo, deadline.dia_inteiro))
+                        selected = saved.id; newForm = false; title = ""; date = ""; time = ""; reload(); notice = "Anotado nas suas tarefas."
+                    } }) { Text("Guardar tarefa") }
+                }
+                if (selected != null) TextButton(onClick = { selected = null }) { Text("Ver todas as tarefas") }
+                val visible = items.filter { selected == null || it.id == selected }
+                if (!busy && error == null && visible.isEmpty()) Text("Nenhuma tarefa nessa lista por enquanto.")
+                visible.forEach { item ->
+                    Card(Modifier.fillMaxWidth()) {
+                        Column(Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(10.dp)) {
+                            Text(when { item.atrasada -> "Prazo vencido"; item.estado == "sugestao" -> "Sugestão de mensagem"; item.estado == "concluida" -> "Concluída"; item.estado == "descartada" -> "Descartada"; else -> "Pendente" },
+                                color = if(item.atrasada) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.secondary)
+                            Text(item.titulo, style = MaterialTheme.typography.titleLarge)
+                            Text(item.quando, color = MaterialTheme.colorScheme.secondary)
+                            Text(item.aviso, style = MaterialTheme.typography.bodySmall)
+                            if (item.contexto.isNotBlank()) Text("Mensagem de origem: " + item.contexto, style = MaterialTheme.typography.bodySmall)
+                            if (item.estado in listOf("pendente", "sugestao")) {
+                                if (item.estado == "sugestao") Button(enabled = !busy, onClick = { run { change(item, "aceitar") } }) { Text("Colocar nas tarefas") }
+                                else {
+                                    Button(enabled = !busy, onClick = { run { change(item, "concluir") } }) { Text("Concluir") }
+                                    OutlinedButton(enabled = !busy, onClick = { postpone = item.id; nextDate = ""; nextTime = "" }) { Text("Adiar") }
+                                }
+                                TextButton(enabled = !busy, onClick = { run { change(item, "descartar") } }) { Text("Descartar") }
+                            }
+                            if (postpone == item.id) {
+                                OutlinedTextField(value = nextDate, onValueChange = { nextDate = it }, label = { Text("Nova data — dd/mm/aaaa") }, modifier = Modifier.fillMaxWidth())
+                                OutlinedTextField(value = nextTime, onValueChange = { nextTime = it }, label = { Text("Horário — HH:mm (opcional)") }, modifier = Modifier.fillMaxWidth())
+                                Button(enabled = !busy, onClick = { run {
+                                    require(nextDate.isNotBlank()) { "Escolha a nova data." }
+                                    change(item, "adiar", TaskDates.deadline(nextDate, nextTime))
+                                } }) { Text("Salvar prazo") }
+                                TextButton(onClick = { postpone = null }) { Text("Cancelar") }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
