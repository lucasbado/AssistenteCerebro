+package com.example.assistentecell.calendar
+
+import android.Manifest
+import android.os.Bundle
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.activity.compose.rememberLauncherForActivityResult
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.compose.foundation.layout.*
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.foundation.verticalScroll
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import com.example.assistentecell.ui.theme.AssistenteCellTheme
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+class CalendarSettingsActivity : ComponentActivity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContent { AssistenteCellTheme(darkTheme = true, dynamicColor = false) { SettingsPage() } }
+    }
+    @Composable private fun SettingsPage() {
+        val scope = rememberCoroutineScope()
+        var granted by remember { mutableStateOf(CalendarMirror.permitted(this)) }
+        var calendars by remember { mutableStateOf<List<WritableCalendar>>(emptyList()) }
+        var status by remember { mutableStateOf(CalendarMirror.status(this)) }
+        var error by remember { mutableStateOf<String?>(null) }
+        var busy by remember { mutableStateOf(false) }
+        val permissions = rememberLauncherForActivityResult(ActivityResultContracts.RequestMultiplePermissions()) {
+            granted = CalendarMirror.permitted(this)
+            if(!granted) error = "Sem autorização, você ainda pode usar Salvar no calendário para revisar cada item manualmente."
+        }
+        LaunchedEffect(granted) {
+            if(granted) calendars = withContext(Dispatchers.IO) { CalendarMirror.calendars(this@CalendarSettingsActivity) }
+        }
+        LaunchedEffect(Unit) { while(true) { status = CalendarMirror.status(this@CalendarSettingsActivity); delay(2000) } }
+        Surface(Modifier.fillMaxSize(), color = MaterialTheme.colorScheme.background) {
+            Column(Modifier.fillMaxSize().systemBarsPadding().verticalScroll(rememberScrollState()).padding(20.dp), verticalArrangement = Arrangement.spacedBy(14.dp)) {
+                TextButton(onClick = { finish() }) { Text("Voltar") }
+                Text("Calendário do celular", style = MaterialTheme.typography.headlineMedium)
+                Text("Salve automaticamente os compromissos confirmados e as tarefas com prazo no calendário que escolher.")
+                Text("Sugestões aguardam sua aprovação. Alterar ou adiar na Ollie atualiza a cópia; concluir ou descartar remove apenas a cópia criada por ela.")
+                Text("O Android pede acesso ao calendário. A integração consulta os calendários disponíveis e as próprias cópias da Ollie; não envia seus outros eventos ao servidor.", style = MaterialTheme.typography.bodySmall)
+                if(!granted) Button(onClick = { permissions.launch(arrayOf(Manifest.permission.READ_CALENDAR, Manifest.permission.WRITE_CALENDAR)) }) { Text("Autorizar calendário") }
+                else {
+                    Text("Escolha onde salvar", style = MaterialTheme.typography.titleMedium)
+                    if(calendars.isEmpty()) Text("Nenhum calendário gravável apareceu. Confira se sua conta está sincronizada no celular.")
+                    calendars.forEach { calendar ->
+                        OutlinedButton(enabled = !busy, modifier = Modifier.fillMaxWidth(), onClick = {
+                            error = null
+                            try { CalendarMirror.configure(this@CalendarSettingsActivity, calendar); status = CalendarMirror.status(this@CalendarSettingsActivity) }
+                            catch(e: Exception) { error = e.message }
+                        }) { Text(calendar.name + " · " + calendar.account) }
+                    }
+                    TextButton(onClick = { CalendarMirror.enqueue(this@CalendarSettingsActivity); status = "Sincronização solicitada…" }) { Text("Sincronizar agora") }
+                    TextButton(onClick = { CalendarMirror.disable(this@CalendarSettingsActivity); status = CalendarMirror.status(this@CalendarSettingsActivity) }) { Text("Pausar integração") }
+                    TextButton(enabled = !busy, onClick = {
+                        busy = true; error = null
+                        scope.launch {
+                            try { CalendarMirror.removeCopies(this@CalendarSettingsActivity); status = CalendarMirror.status(this@CalendarSettingsActivity) }
+                            catch(e: Exception) { error = e.message }
+                            finally { busy = false }
+                        }
+                    }) { Text("Desconectar e remover cópias da Ollie") }
+                }
+                if(CalendarMirror.enabled(this@CalendarSettingsActivity)) Text("Conectado a: " + CalendarMirror.selectedName(this@CalendarSettingsActivity), style = MaterialTheme.typography.titleMedium)
+                Text(status, color = MaterialTheme.colorScheme.secondary)
+                error?.let { Text(it, color = MaterialTheme.colorScheme.error) }
+                Text("Sem data, tarefas ficam só na Ollie. Compromissos sem duração usam 1 hora; tarefas com horário são marcadores de 1 minuto sem reservar disponibilidade. A cópia não acrescenta outro alarme. Mudanças feitas no calendário não retornam à Ollie.", style = MaterialTheme.typography.bodySmall)
+            }
+        }
+    }
+}
