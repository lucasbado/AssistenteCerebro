@@ -0,0 +1,40 @@
+package com.example.assistentecell.calendar
+
+import java.text.SimpleDateFormat
+import java.util.Locale
+import java.util.TimeZone
+import com.example.assistentecell.agenda.AgendaDates
+
+data class CalendarKnown(val dominio: String, val id: String)
+data class CalendarRequest(val conhecidos: List<CalendarKnown>)
+data class CalendarFeed(val itens: List<CalendarEntry>)
+data class CalendarEntry(val id: String, val dominio: String, val titulo: String, val ativo: Boolean,
+    val inicio: String?, val data_local: String?, val dia_inteiro: Boolean, val fuso: String,
+    val duracao_minutos: Int, val descricao: String) {
+    val key: String get() = "$dominio:$id"
+}
+data class CalendarPeriod(val begin: Long, val end: Long, val zone: String)
+
+object CalendarRules {
+    fun period(item: CalendarEntry): CalendarPeriod {
+        require(item.ativo && item.inicio != null) { "Item sem data confirmada." }
+        if (item.dia_inteiro) {
+            val day = requireNotNull(item.data_local)
+            require(Regex("\\d{4}-\\d{2}-\\d{2}").matches(day))
+            val start = SimpleDateFormat("yyyy-MM-dd", Locale.ROOT).apply {
+                isLenient = false; timeZone = TimeZone.getTimeZone("UTC")
+            }.parse(day)!!.time
+            return CalendarPeriod(start, start + 86400000L, "UTC")
+        }
+        val start = AgendaDates.instant(item.inicio)
+        require(item.duracao_minutos in 1..1440)
+        return CalendarPeriod(start, start + item.duracao_minutos * 60000L, item.fuso)
+    }
+    fun decision(active: Boolean, mapped: Boolean, exists: Boolean, same: Boolean): String = when {
+        !active -> if(mapped && exists) "delete" else "skip"
+        !mapped -> "insert"
+        !exists -> if(same) "skip" else "insert"
+        same -> "skip"
+        else -> "update"
+    }
+}
