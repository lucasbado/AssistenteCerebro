@@ -0,0 +1,16 @@
+package com.example.assistentecell
+import com.example.assistentecell.tarefas.TaskDates
+import org.junit.Assert.*
+import org.junit.Test
+class TaskDatesTest {
+    @Test fun optionalDeadlineStaysEmpty() {
+        assertNull(TaskDates.deadline("", "").prazo)
+        assertFalse(TaskDates.deadline("", "").dia_inteiro)
+    }
+    @Test(expected = IllegalArgumentException::class) fun clockRequiresDate() { TaskDates.deadline("", "15:00") }
+    @Test fun dayOnlyAndExactTimeStayDifferent() {
+        assertTrue(TaskDates.deadline("23/10/2030", "").dia_inteiro)
+        assertFalse(TaskDates.deadline("23/10/2030", "15:00").dia_inteiro)
+    }
+    @Test(expected = java.text.ParseException::class) fun impossibleDateDoesNotRollOver() { TaskDates.deadline("30/02/2030", "15:00") }
+}
