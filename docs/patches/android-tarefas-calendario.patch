+package com.example.assistentecell
+
+import android.content.ContentUris
+import android.content.ContentValues
+import android.content.Context
+import android.net.Uri
+import android.provider.CalendarContract
+import androidx.test.ext.junit.runners.AndroidJUnit4
+import androidx.test.platform.app.InstrumentationRegistry
+import com.example.assistentecell.calendar.CalendarMirror
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import java.util.UUID
+
+@RunWith(AndroidJUnit4::class)
+class CalendarProviderWriteTest {
+    @Test fun selectedCalendarAcceptsUpdatesAndRemovesOnlyTemporaryOwnEvent() {
+        val context = InstrumentationRegistry.getInstrumentation().targetContext
+        assertTrue("Autorize o calendário na interface do aplicativo.", CalendarMirror.permitted(context))
+        val selected = context.getSharedPreferences("ollie_calendar", Context.MODE_PRIVATE).getLong("calendar_id", -1)
+        assertTrue("Escolha o calendário na interface do aplicativo.", selected >= 0)
+        val marker = "ollie://calendar/test/" + UUID.randomUUID()
+        val start = System.currentTimeMillis() + 86400000L
+        var created: Uri? = null
+        try {
+            created = context.contentResolver.insert(CalendarContract.Events.CONTENT_URI, ContentValues().apply {
+                put(CalendarContract.Events.CALENDAR_ID, selected)
+                put(CalendarContract.Events.TITLE, "Ollie — teste temporário de calendário")
+                put(CalendarContract.Events.DESCRIPTION, "Verificação automática; removida imediatamente. Sem alarme ou convidados.")
+                put(CalendarContract.Events.DTSTART, start); put(CalendarContract.Events.DTEND, start + 60000L)
+                put(CalendarContract.Events.EVENT_TIMEZONE, "UTC")
+                put(CalendarContract.Events.AVAILABILITY, CalendarContract.Events.AVAILABILITY_FREE)
+                put(CalendarContract.Events.HAS_ALARM, 0)
+                put(CalendarContract.Events.CUSTOM_APP_PACKAGE, context.packageName)
+                put(CalendarContract.Events.CUSTOM_APP_URI, marker)
+            })
+            val uri = requireNotNull(created)
+            assertTrue(ContentUris.parseId(uri) >= 0)
+            assertEquals(1, context.contentResolver.update(uri, ContentValues().apply {
+                put(CalendarContract.Events.DTSTART, start + 3600000L)
+                put(CalendarContract.Events.DTEND, start + 3660000L)
+            }, null, null))
+            context.contentResolver.query(uri, arrayOf(CalendarContract.Events.DTSTART,
+                CalendarContract.Events.CUSTOM_APP_URI, CalendarContract.Events.HAS_ALARM), null, null, null)!!.use {
+                assertTrue(it.moveToFirst())
+                assertEquals(start + 3600000L, it.getLong(0))
+                assertEquals(marker, it.getString(1))
+                assertEquals(0, it.getInt(2))
+            }
+        } finally {
+            created?.let { context.contentResolver.delete(it, null, null) }
+        }
+        created?.let { uri ->
+            context.contentResolver.query(uri, arrayOf(CalendarContract.Events.DELETED), null, null, null)?.use {
+                assertTrue("Evento temporário deve estar removido.", !it.moveToFirst() || it.getInt(0) != 0)
+            }
+        }
+    }
+}
