diff --git a/app/src/main/java/com/example/assistentecell/calendar/CalendarMirror.kt b/app/src/main/java/com/example/assistentecell/calendar/CalendarMirror.kt
new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/example/assistentecell/calendar/CalendarMirror.kt
@@ -0,0 +1,167 @@
+package com.example.assistentecell.calendar
+
+import android.Manifest
+import android.content.ContentUris
+import android.content.ContentValues
+import android.content.Context
+import android.content.pm.PackageManager
+import android.provider.CalendarContract
+import androidx.core.content.ContextCompat
+import androidx.work.*
+import com.example.assistentecell.api.RetrofitClient
+import com.google.gson.Gson
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import java.security.MessageDigest
+import java.util.concurrent.TimeUnit
+
+data class WritableCalendar(val id: Long, val name: String, val account: String)
+
+object CalendarMirror {
+    private val lock = Mutex()
+    private val gson = Gson()
+    private fun prefs(c: Context) = c.getSharedPreferences("ollie_calendar", Context.MODE_PRIVATE)
+    fun permitted(c: Context) = arrayOf(Manifest.permission.READ_CALENDAR, Manifest.permission.WRITE_CALENDAR)
+        .all { ContextCompat.checkSelfPermission(c, it) == PackageManager.PERMISSION_GRANTED }
+    fun enabled(c: Context) = prefs(c).getBoolean("enabled", false)
+    fun selectedName(c: Context) = prefs(c).getString("calendar_name", "")!!
+    fun status(c: Context) = prefs(c).getString("status", "Ainda não sincronizado.")!!
+    private fun marker(item: CalendarEntry) = "ollie://calendar/${item.dominio}/${item.id}"
+    private fun mappings(c: Context) = prefs(c).all.filterKeys { it.startsWith("event:") }
+
+    fun calendars(c: Context): List<WritableCalendar> {
+        if (!permitted(c)) return emptyList()
+        val result = mutableListOf<WritableCalendar>()
+        c.contentResolver.query(CalendarContract.Calendars.CONTENT_URI,
+            arrayOf("_id", CalendarContract.Calendars.CALENDAR_DISPLAY_NAME, CalendarContract.Calendars.ACCOUNT_NAME),
+            "${CalendarContract.Calendars.CALENDAR_ACCESS_LEVEL} >= ? AND ${CalendarContract.Calendars.VISIBLE} = 1",
+            arrayOf(CalendarContract.Calendars.CAL_ACCESS_CONTRIBUTOR.toString()), null)?.use { cursor ->
+            while(cursor.moveToNext()) result.add(WritableCalendar(cursor.getLong(0), cursor.getString(1) ?: "Calendário", cursor.getString(2) ?: "Local"))
+        }
+        return result
+    }
+
+    fun configure(c: Context, calendar: WritableCalendar) {
+        require(permitted(c)) { "Autorize o calendário primeiro." }
+        require(calendars(c).any { it.id == calendar.id }) { "Esse calendário não permite salvar eventos." }
+        val p = prefs(c)
+        require(p.getLong("calendar_id", calendar.id) == calendar.id || mappings(c).isEmpty()) {
+            "Remova as cópias da Ollie antes de trocar de calendário."
+        }
+        p.edit().putLong("calendar_id", calendar.id).putString("calendar_name", calendar.name)
+            .putBoolean("enabled", true).putString("status", "Aguardando sincronização com o servidor…").apply()
+        val periodic = PeriodicWorkRequestBuilder<CalendarSyncWorker>(15, TimeUnit.MINUTES)
+            .setConstraints(Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build()).build()
+        WorkManager.getInstance(c).enqueueUniquePeriodicWork("ollie-calendar-periodic", ExistingPeriodicWorkPolicy.UPDATE, periodic)
+        enqueue(c)
+    }
+
+    fun disable(c: Context) {
+        prefs(c).edit().putBoolean("enabled", false).putString("status", "Integração pausada. Cópias existentes foram mantidas.").apply()
+        WorkManager.getInstance(c).cancelUniqueWork("ollie-calendar-periodic")
+        WorkManager.getInstance(c).cancelUniqueWork("ollie-calendar-now")
+    }
+    fun enqueue(c: Context) {
+        if (!enabled(c) || !permitted(c)) return
+        WorkManager.getInstance(c).enqueueUniqueWork("ollie-calendar-now", ExistingWorkPolicy.APPEND_OR_REPLACE,
+            OneTimeWorkRequestBuilder<CalendarSyncWorker>().setConstraints(
+                Constraints.Builder().setRequiredNetworkType(NetworkType.CONNECTED).build()).build())
+    }
+
+    private fun own(c: Context, id: Long, uri: String): Boolean {
+        c.contentResolver.query(ContentUris.withAppendedId(CalendarContract.Events.CONTENT_URI, id),
+            arrayOf(CalendarContract.Events.CUSTOM_APP_PACKAGE, CalendarContract.Events.CUSTOM_APP_URI), null, null, null)?.use {
+            return it.moveToFirst() && it.getString(0) == c.packageName && it.getString(1) == uri
+        }
+        return false
+    }
+
+    suspend fun removeCopies(c: Context) = withContext(Dispatchers.IO) { lock.withLock {
+        disable(c)
+        require(permitted(c)) { "Autorize o calendário para remover as cópias." }
+        val p = prefs(c)
+        for ((key, value) in mappings(c)) {
+            val domainId = key.removePrefix("event:").split(":", limit = 2)
+            val uri = "ollie://calendar/${domainId[0]}/${domainId[1]}"
+            val id = value as Long
+            if (own(c, id, uri)) c.contentResolver.delete(ContentUris.withAppendedId(CalendarContract.Events.CONTENT_URI, id), null, null)
+            p.edit().remove(key).remove("hash:" + key.removePrefix("event:")).commit()
+        }
+        p.edit().remove("calendar_id").putString("status", "Cópias da Ollie removidas; integração desligada.").apply()
+    } }
+
+    suspend fun sync(c: Context) = withContext(Dispatchers.IO) { lock.withLock {
+        if (!enabled(c) || !permitted(c)) return@withLock
+        val p = prefs(c)
+        val calendarId = p.getLong("calendar_id", -1)
+        require(calendars(c).any { it.id == calendarId }) { "O calendário escolhido não está mais disponível." }
+        // Recupera somente nossas próprias cópias após interrupção entre insert e gravação do ID.
+        c.contentResolver.query(CalendarContract.Events.CONTENT_URI,
+            arrayOf(CalendarContract.Events._ID, CalendarContract.Events.CUSTOM_APP_URI),
+            "${CalendarContract.Events.CALENDAR_ID} = ? AND ${CalendarContract.Events.CUSTOM_APP_PACKAGE} = ?",
+            arrayOf(calendarId.toString(), c.packageName), null)?.use { cursor ->
+            while(cursor.moveToNext()) {
+                val uri = cursor.getString(1).orEmpty()
+                val match = Regex("ollie://calendar/(agenda|tarefa)/([0-9a-fA-F-]{36})").matchEntire(uri) ?: continue
+                val key = match.groupValues[1] + ":" + match.groupValues[2]
+                if(!p.contains("event:" + key)) check(p.edit().putLong("event:" + key, cursor.getLong(0)).commit())
+            }
+        }
+        RetrofitClient.init(c)
+        val known = mappings(c).keys.take(1000).map { key ->
+            val parts = key.removePrefix("event:").split(":", limit = 2)
+            CalendarKnown(parts[0], parts[1])
+        }
+        val feed = RetrofitClient.cognitiveApiService.syncCalendar(CalendarRequest(known))
+        for (item in feed.itens) {
+            if (!enabled(c) || !permitted(c)) return@withLock
+            require(item.dominio in listOf("agenda", "tarefa") && item.id.matches(Regex("[0-9a-fA-F-]{36}")))
+            val id = p.getLong("event:" + item.key, -1)
+            val hash = MessageDigest.getInstance("SHA-256").digest(gson.toJson(item).toByteArray()).joinToString("") { "%02x".format(it) }
+            val same = p.getString("hash:" + item.key, "") == hash
+            val exists = id >= 0 && own(c, id, marker(item))
+            // A mapped ID that now belongs to somebody else is never modified.
+            val decision = CalendarRules.decision(item.ativo, id >= 0, exists, same)
+            if (decision == "delete") c.contentResolver.delete(ContentUris.withAppendedId(CalendarContract.Events.CONTENT_URI, id), null, null)
+            if (!item.ativo) { p.edit().remove("event:" + item.key).remove("hash:" + item.key).commit(); continue }
+            if (decision == "skip") continue
+            val period = CalendarRules.period(item)
+            val values = ContentValues().apply {
+                put(CalendarContract.Events.CALENDAR_ID, calendarId)
+                put(CalendarContract.Events.TITLE, item.titulo)
+                put(CalendarContract.Events.DESCRIPTION, item.descricao)
+                put(CalendarContract.Events.DTSTART, period.begin); put(CalendarContract.Events.DTEND, period.end)
+                put(CalendarContract.Events.EVENT_TIMEZONE, period.zone)
+                put(CalendarContract.Events.ALL_DAY, if(item.dia_inteiro) 1 else 0)
+                put(CalendarContract.Events.AVAILABILITY, if(item.dominio == "tarefa") CalendarContract.Events.AVAILABILITY_FREE else CalendarContract.Events.AVAILABILITY_BUSY)
+                put(CalendarContract.Events.CUSTOM_APP_PACKAGE, c.packageName); put(CalendarContract.Events.CUSTOM_APP_URI, marker(item))
+                put(CalendarContract.Events.HAS_ALARM, 0)
+            }
+            val saved = if (decision == "update") {
+                check(c.contentResolver.update(ContentUris.withAppendedId(CalendarContract.Events.CONTENT_URI, id), values, null, null) == 1)
+                id
+            } else ContentUris.parseId(requireNotNull(c.contentResolver.insert(CalendarContract.Events.CONTENT_URI, values)))
+            check(p.edit().putLong("event:" + item.key, saved).putString("hash:" + item.key, hash).commit())
+        }
+        p.edit().putString("status", "Calendário atualizado. Sugestões e despertadores não são copiados.").apply()
+    } }
+
+    fun failed(c: Context, error: Exception) {
+        val message = when {
+            error is retrofit2.HttpException && error.code() == 404 -> "Calendário conectado. Falta atualizar o servidor no Render para copiar seus itens."
+            error is retrofit2.HttpException && error.code() == 401 -> "Calendário conectado. Confira o token do servidor nas configurações."
+            error is SecurityException -> "Autorize o acesso ao calendário para retomar a integração."
+            else -> "Não consegui atualizar o calendário agora. Confira a conexão e tente Sincronizar agora."
+        }
+        prefs(c).edit().putString("status", message).apply()
+    }
+}
+
+class CalendarSyncWorker(context: Context, params: WorkerParameters) : CoroutineWorker(context, params) {
+    override suspend fun doWork(): Result = try {
+        CalendarMirror.sync(applicationContext); Result.success()
+    } catch (e: kotlinx.coroutines.CancellationException) { throw e }
+      catch (e: Exception) { CalendarMirror.failed(applicationContext, e); if(runAttemptCount < 3) Result.retry() else Result.failure() }
+}
