@@ -0,0 +1,25 @@
+package com.example.assistentecell
+import com.example.assistentecell.calendar.*
+import com.example.assistentecell.agenda.AgendaDates
+import org.junit.Assert.*
+import org.junit.Test
+class CalendarRulesTest {
+    @Test fun dayOnlyUsesUtcMidnightOfDeclaredDate() {
+        val item = CalendarEntry("id", "agenda", "Data importante", true, "2030-10-23T03:00:00+00:00", "2030-10-23", true, "America/Sao_Paulo", 60, "")
+        val period = CalendarRules.period(item)
+        assertEquals(AgendaDates.instant("2030-10-23T00:00:00Z"), period.begin)
+        assertEquals(86400000L, period.end - period.begin)
+        assertEquals("UTC", period.zone)
+    }
+    @Test fun postponedTimeUpdatesSameCopyAndDoesNotDuplicate() {
+        assertEquals("update", CalendarRules.decision(true, true, true, false))
+        assertEquals("skip", CalendarRules.decision(true, true, true, true))
+    }
+    @Test fun userDeletedCalendarCopyIsNotRecreatedWithoutChange() {
+        assertEquals("skip", CalendarRules.decision(true, true, false, true))
+    }
+    @Test fun onlyMappedCopiesCanBeRemoved() {
+        assertEquals("skip", CalendarRules.decision(false, false, true, false))
+        assertEquals("delete", CalendarRules.decision(false, true, true, false))
+    }
+}
