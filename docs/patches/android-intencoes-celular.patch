+package com.example.assistentecell
+
+import com.example.assistentecell.command.AppUiPolicy
+import com.example.assistentecell.command.MobileControlRequest
+import org.junit.Assert.*
+import org.junit.Test
+
+class AppUiPolicyTest {
+    @Test fun genericUiDoesNotSendOrAuthorize() {
+        for(label in listOf("Enviar", "Send message", "button_send", "Confirmar compra", "Permitir", "Excluir", "Fazer transferência", "Ligar para Ana", "Publicar")) {
+            assertFalse(label, AppUiPolicy.canTap(label))
+        }
+        assertFalse(AppUiPolicy.canTap(""))
+        assertTrue(AppUiPolicy.canTap("Pesquisar"))
+        assertTrue(AppUiPolicy.canTap("Biblioteca"))
+    }
+    @Test fun typingOnlySearchFieldsNotChatOrPassword() {
+        assertTrue(AppUiPolicy.canType("Pesquisar", false))
+        assertTrue(AppUiPolicy.canType("search_input", false))
+        assertFalse(AppUiPolicy.canType("Mensagem", false))
+        assertFalse(AppUiPolicy.canType("Pesquisar", true))
+        assertFalse(AppUiPolicy.canType("Password search", false))
+    }
+    private fun parse(action: String, params: String) = MobileControlRequest.parse("""{"pedido_usuario":true,"id_comando":"teste","acao":"$action","parametros":$params}""")
+    @Test fun repeatedAlarmAndAppActionsHaveStrictContract() {
+        assertEquals("alarm.create", parse("alarm.create", """{"hora":7,"minuto":30,"dias":[2,3,4,5,6]}""").action)
+        assertEquals("app.open", parse("app.open", """{"pacote":"com.sec.android.app.clockpackage"}""").action)
+        assertEquals("ui.snapshot", parse("ui.snapshot", """{"pacote":"com.calculator"}""").action)
+        assertEquals("clock.open", parse("clock.open", "{}").action)
+        for(args in listOf("""{"hora":7,"minuto":30,"dias":[true]}""", """{"hora":7,"minuto":30,"dias":[2,2]}""")) {
+            assertTrue(runCatching { parse("alarm.create", args) }.isFailure)
+        }
+        assertTrue(runCatching { parse("app.open", """{"pacote":"com.app; shell"}""") }.isFailure)
+        assertTrue(runCatching { parse("ui.tap", """{"pacote":"com.app","captura":"a","node":0}""") }.isFailure)
+    }
+}
