new file mode 100644
--- /dev/null
+++ b/app/src/main/java/com/example/assistentecell/command/AppUiController.kt
@@ -0,0 +1,95 @@
+package com.example.assistentecell.command
+
+import android.graphics.Rect
+import android.content.Context
+import android.os.Bundle
+import android.os.SystemClock
+import android.view.accessibility.AccessibilityNodeInfo
+import android.view.accessibility.AccessibilityWindowInfo
+import com.example.assistentecell.accessibility.OllieAccessibilityService
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.UUID
+
+/** Short-lived node references. No screen content is written to disk. All calls run on Main. */
+object AppUiController {
+    private data class Entry(val path: List<Int>, val fingerprint: String)
+    private data class Capture(val id: String, val pkg: String, val expires: Long, val entries: List<Entry>)
+    private var capture: Capture? = null
+
+    private fun root(pkg: String): AccessibilityNodeInfo? {
+        if (pkg in setOf("com.android.settings", "com.android.systemui", "com.google.android.permissioncontroller", "com.android.permissioncontroller", "com.google.android.packageinstaller")) return null
+        val service = OllieAccessibilityService.getInstance() ?: return null
+        val active = service.rootInActiveWindow
+        if (active?.packageName?.toString() == pkg) return active
+        // An assistant overlay may cover the app; do not bypass another application's foreground window.
+        val app = service.windows.firstOrNull { it.type == AccessibilityWindowInfo.TYPE_APPLICATION && it.root != null }
+        val node = app?.root ?: return null
+        return node.takeIf { it.packageName?.toString() == pkg }
+    }
+    fun foreground(pkg: String) = root(pkg) != null
+    private fun label(node: AccessibilityNodeInfo) = listOf(node.text, node.contentDescription, node.hintText, node.viewIdResourceName).filterNotNull().joinToString(" ")
+    private fun fingerprint(node: AccessibilityNodeInfo): String {
+        val rect = Rect(); node.getBoundsInScreen(rect)
+        return listOf(node.packageName, node.className, node.viewIdResourceName, label(node), rect.toShortString(),
+            node.isClickable, node.isEditable, node.isScrollable, node.isEnabled).joinToString("|")
+    }
+    private fun allowed(context: Context) = context.getSharedPreferences("app_screen_consent", Context.MODE_PRIVATE)
+        .getBoolean("remote_screen_interpretation", false)
+    fun snapshot(context: Context, pkg: String): MobileControlExecutor.Result {
+        if (!allowed(context)) { capture = null; return consentRequired() }
+        val root = root(pkg) ?: return unavailable()
+        val nodes = JSONArray()
+        val entries = mutableListOf<Entry>()
+        var visited = 0
+        var size = 0
+        fun visit(node: AccessibilityNodeInfo, path: List<Int>) {
+            if (++visited > 600 || entries.size >= 80 || path.size > 25) return
+            if (node.isVisibleToUser && !node.isPassword && node.isEnabled &&
+                (node.isClickable || node.isEditable || node.isScrollable || !node.text.isNullOrBlank() || !node.contentDescription.isNullOrBlank())) {
+                val safe = label(node)
+                val data = JSONObject().put("id", entries.size)
+                    .put("texto", if(node.isEditable) "" else node.text?.toString().orEmpty().take(160))
+                    .put("descricao", (node.contentDescription?.toString() ?: node.hintText?.toString().orEmpty()).take(160))
+                    .put("tipo", node.className?.toString().orEmpty().take(160))
+                    .put("clicavel", node.isClickable && AppUiPolicy.canTap(safe) && (!node.text.isNullOrBlank() || !node.contentDescription.isNullOrBlank()))
+                    .put("editavel", node.isEditable && AppUiPolicy.canType(safe, node.isPassword))
+                    .put("rolavel", node.isScrollable)
+                val cost = data.toString().length
+                if (size + cost <= 13000) {
+                    size += cost
+                    nodes.put(data)
+                    entries.add(Entry(path, fingerprint(node)))
+                }
+            }
+            for (i in 0 until node.childCount) node.getChild(i)?.let { visit(it, path + i) }
+        }
+        visit(root, emptyList())
+        val id = UUID.randomUUID().toString()
+        capture = Capture(id, pkg, SystemClock.elapsedRealtime() + 15000, entries)
+        return MobileControlExecutor.Result("concluido", "Tela consultada.", JSONObject().put("pacote", pkg).put("captura", id).put("nodes", nodes))
+    }
+    fun act(context: Context, r: MobileControlRequest): MobileControlExecutor.Result {
+        if (!allowed(context)) { capture = null; return consentRequired() }
+        val c = capture ?: return stale()
+        if (c.id != r.text("captura") || c.pkg != r.text("pacote") || c.expires < SystemClock.elapsedRealtime()) return stale()
+        val entry = c.entries.getOrNull(r.number("node")) ?: return stale()
+        var node = root(c.pkg) ?: return unavailable()
+        for (index in entry.path) node = node.getChild(index) ?: return stale()
+        if (!node.isVisibleToUser || !node.isEnabled || node.isPassword || fingerprint(node) != entry.fingerprint) return stale()
+        capture = null // One action per capture, including failures.
+        val safe = label(node)
+        val ok = when(r.action) {
+            "ui.tap" -> node.isClickable && AppUiPolicy.canTap(safe) && (!node.text.isNullOrBlank() || !node.contentDescription.isNullOrBlank()) && node.performAction(AccessibilityNodeInfo.ACTION_CLICK)
+            "ui.type" -> node.isEditable && AppUiPolicy.canType(safe, node.isPassword) && node.performAction(
+                AccessibilityNodeInfo.ACTION_SET_TEXT, Bundle().apply { putCharSequence(AccessibilityNodeInfo.ACTION_ARGUMENT_SET_TEXT_CHARSEQUENCE, r.text("texto")) })
+            "ui.scroll" -> node.isScrollable && node.performAction(if(r.text("direcao") == "forward") AccessibilityNodeInfo.ACTION_SCROLL_FORWARD else AccessibilityNodeInfo.ACTION_SCROLL_BACKWARD)
+            else -> false
+        }
+        return if(ok) MobileControlExecutor.Result("concluido", "O Android aceitou essa etapa na tela.")
+        else MobileControlExecutor.Result("encaminhado", "Essa etapa precisa de um toque seu no aplicativo.")
+    }
+    private fun stale() = MobileControlExecutor.Result("encaminhado", "A tela mudou. Parei para não tocar no elemento errado.")
+    private fun unavailable() = MobileControlExecutor.Result("permissao", "Deixe o aplicativo aberto e autorize Controle Ollie em Acessibilidade para eu consultar essa tela.")
+    private fun consentRequired() = MobileControlExecutor.Result("permissao", "A leitura de telas está desligada. Para navegar dentro de apps com IA, autorize o envio da tela em Configurações da Ollie → Controles do celular → Interpretação da tela por IA. Despertadores e controles nativos não precisam disso.")
+}
